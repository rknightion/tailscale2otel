{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-posture-integration-stale"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel-tailnet",
      "__panelId__": "183",
      "description": "A device-posture (MDM/EDR) integration has not synced in over 24h ({{ $labels.tailscale_posture_provider }}/{{ $labels.tailscale_posture_integration }}) \u2014 posture data from it is stale. Absent until an integration exists. NOTE: Tailscale updates last_sync on every sync *attempt*, including failures, so this alert cannot detect a persistently-failing-but-still-retrying integration (bad/revoked credentials) \u2014 see ts2o-posture-integration-error for that case (#99).",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#posture-integrations",
      "summary": "Posture integration {{ $labels.tailscale_posture_provider }} sync is stale"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "max by (tailscale_posture_provider, tailscale_posture_integration) (time() - tailscale_posture_integration_last_sync_seconds)",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  86400
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "1h0m0s",
    "labels": {
      "domain": "security",
      "service": "tailscale2otel",
      "severity": "warning"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "Posture integration sync stale",
    "trigger": {
      "interval": "1m"
    }
  }
}
