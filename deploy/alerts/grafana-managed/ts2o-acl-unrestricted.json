{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-acl-unrestricted"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel-tailnet",
      "__panelId__": "25",
      "description": "sum(tailscale_acl_unrestricted_rules_ratio) > 0 \u2014 one or more ACL grants/rules are unrestricted (e.g. * to *). Review the ACL hygiene row on the Security & Audit tab.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#acl-policy-hygiene",
      "summary": "The tailnet policy has unrestricted (wide-open) rules"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum(tailscale_acl_unrestricted_rules_ratio)",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "15m0s",
    "labels": {
      "domain": "security",
      "service": "tailscale2otel",
      "severity": "warning"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "Unrestricted ACL rules present",
    "trigger": {
      "interval": "1m"
    }
  }
}
