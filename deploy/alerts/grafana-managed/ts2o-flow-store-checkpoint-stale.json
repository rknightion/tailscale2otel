{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-flow-store-checkpoint-stale"
  },
  "spec": {
    "annotations": {
      "description": "The persistent flow store has not completed a SQLite WAL checkpoint for over two hours, sustained for 15m. A stuck checkpoint can grow the write-ahead journal. Check flow-store errors, disk space, and long-running SQLite readers. The default idle maintenance cadence is hourly; tune the threshold if using a longer sweep interval. Absence is OK for memory stores and before the first checkpoint.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#flow-data-pipeline",
      "summary": "Persistent flow-store checkpoint is stale for {{ $labels.tailscale_tailnet }}"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "time() - min by (tailscale_tailnet) (tailscale2otel_flow_store_last_checkpoint_timestamp_seconds > 0)",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  7200
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "15m0s",
    "labels": {
      "domain": "observability",
      "service": "tailscale2otel",
      "severity": "warning",
      "skipinvestigation": "true"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "Flow store checkpoint stale",
    "trigger": {
      "interval": "1m"
    }
  }
}
