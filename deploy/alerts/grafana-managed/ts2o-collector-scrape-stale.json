{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-collector-scrape-stale"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel",
      "__panelId__": "309",
      "description": "time() - tailscale2otel_scrape_last_timestamp_seconds > 1h for collector {{ $labels.tailscale_collector }} \u2014 it is wedged (the success gauge can stay stale at 1), so that collector's series are not refreshing. Complements CollectorScrapeFailing.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#collector-scrape-health",
      "summary": "Collector {{ $labels.tailscale_collector }} has not completed a scrape recently"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "max by (tailscale_collector) (time() - tailscale2otel_scrape_last_timestamp_seconds)",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  3600
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "10m0s",
    "labels": {
      "domain": "observability",
      "service": "tailscale2otel",
      "severity": "warning",
      "skipinvestigation": "true"
    },
    "noDataState": "NoData",
    "paused": false,
    "title": "Collector scrape stale",
    "trigger": {
      "interval": "1m"
    }
  }
}
