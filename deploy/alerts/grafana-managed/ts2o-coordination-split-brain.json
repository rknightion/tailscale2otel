{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-coordination-split-brain"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel-health",
      "__panelId__": "6",
      "description": "The Kubernetes Lease {{ $labels.coordination_lease_name }} in namespace {{ $labels.coordination_namespace }} has more than one replica reporting leadership for 5m. Multiple active replicas can duplicate collection and double-count logs. This is advisory and non-paging while operators establish a baseline for expected handover time. Inspect the Lease leadership panel for the identities reporting leader, then check the Lease object, API-server latency, and the election timing. Absence stays OK: coordination.mode=kubernetes is optional.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#checkpoint-health",
      "summary": "Lease {{ $labels.coordination_lease_name }} has multiple leaders"
    },
    "execErrState": "Ok",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (coordination_lease_name, coordination_namespace) (tailscale2otel_coordination_leader_ratio)",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  1
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "5m0s",
    "labels": {
      "domain": "observability",
      "service": "tailscale2otel",
      "severity": "advisory",
      "skipinvestigation": "true"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "Coordination split brain",
    "trigger": {
      "interval": "1m"
    }
  }
}
