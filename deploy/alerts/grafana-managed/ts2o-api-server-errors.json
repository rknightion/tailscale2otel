{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-api-server-errors"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel-overview",
      "__panelId__": "344",
      "description": "Sustained HTTP 5xx from the Tailscale API (>0.05/s) \u2014 Tailscale-side instability; the exporter retries but data may be delayed.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#tailscale-api-health",
      "summary": "Tailscale API returning 5xx"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum(rate(tailscale2otel_api_requests_total{http_response_status_code=~\"5..\"}[10m]))",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0.05
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "15m0s",
    "labels": {
      "domain": "observability",
      "service": "tailscale2otel",
      "severity": "warning",
      "skipinvestigation": "true"
    },
    "noDataState": "Ok",
    "paused": true,
    "title": "Tailscale API server errors",
    "trigger": {
      "interval": "1m"
    }
  }
}
