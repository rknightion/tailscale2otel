{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-coordination-flapping"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel-health",
      "__panelId__": "23",
      "description": "The Kubernetes Lease {{ $labels.coordination_lease_name }} in namespace {{ $labels.coordination_namespace }} completed at least three leadership handovers within 15m and remained above that threshold for 5m. One controlled leader replacement plus one recovery transition remains quiet; a third transition is repeated churn, commonly caused by a renew deadline too tight for observed API-server latency. This is advisory and non-paging while operators establish a live baseline. Inspect the leadership-handover panel, Lease events, API-server latency, and the configured election timings. Absence stays OK because Kubernetes coordination is optional and a process restart emits an initial zero rather than a handover.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#checkpoint-health",
      "summary": "Lease {{ $labels.coordination_lease_name }} is handing over repeatedly"
    },
    "execErrState": "Ok",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by (coordination_lease_name, coordination_namespace) (increase(tailscale2otel_coordination_handovers_total[15m]))",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  2
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "5m0s",
    "labels": {
      "domain": "observability",
      "service": "tailscale2otel",
      "severity": "advisory",
      "skipinvestigation": "true"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "Coordination flapping",
    "trigger": {
      "interval": "1m"
    }
  }
}
