{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-device-posture-impacting"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel-tailnet",
      "__panelId__": "78",
      "description": "One or more devices have failed a server-evaluated impacting posture for 15 minutes. Inspect assertion change logs and repair the failing device posture. The rollup is available with per-device metrics disabled; absent when no posture verdicts are reported. Posture names are capped at 50 per poll.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#device-posture-coverage",
      "summary": "Devices fail impacting posture {{ $labels.tailscale_posture_name }}"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "max by (tailscale_tailnet, tailscale2otel_provider, tailscale_posture_name) (tailscale_devices_posture_failed_ratio{tailscale_posture_impacting=\"true\"})",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "15m0s",
    "labels": {
      "domain": "security",
      "service": "tailscale2otel",
      "severity": "warning"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "Devices failing impacting postures",
    "trigger": {
      "interval": "1m"
    }
  }
}
