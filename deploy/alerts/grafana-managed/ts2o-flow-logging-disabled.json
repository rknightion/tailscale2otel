{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-flow-logging-disabled"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel-tailnet",
      "__panelId__": "8",
      "description": "tailscale_feature_enabled_ratio{tailscale_feature=\"network_flow_logging\"} == 0 \u2014 the tailnet is not exporting network flow logs, so flow-based forensics/audit data is not being captured. Ships PAUSED because many tailnets legitimately run without flow logging (a paid feature); enable it if flow logging is expected for this tailnet. Absent (=> not firing) when the flowlogs collector is disabled entirely. Grafana-managed equivalent of the datasource-managed FlowLoggingDisabled rule.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#tailnet-settings-drift",
      "summary": "Tailnet network flow logging is disabled"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "min(tailscale_feature_enabled_ratio{tailscale_feature=\"network_flow_logging\"})",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  1
                ],
                "type": "lt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "30m0s",
    "labels": {
      "domain": "security",
      "service": "tailscale2otel",
      "severity": "warning",
      "skipinvestigation": "true"
    },
    "noDataState": "Ok",
    "paused": true,
    "title": "Network flow logging disabled",
    "trigger": {
      "interval": "1m"
    }
  }
}
