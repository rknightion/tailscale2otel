{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-subrequest-coverage-incomplete"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel-health",
      "__panelId__": "79",
      "description": "Per-entity subrequest coverage has stayed below 1 for collector {{ $labels.tailscale_collector }} on {{ $labels.tailscale_tailnet }} for 15m. The enclosing scrape can succeed while posture or invite data is incomplete. Check subrequest failures by type and availability state for permissions or API failures. Complete coverage is 1, including when no entities need a subrequest; the alert resolves when all subrequest types recover to 1. Optional collectors without subrequests produce no series and stay quiet.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#tailscale-api-health",
      "summary": "Collector {{ $labels.tailscale_collector }} subrequest coverage incomplete for {{ $labels.tailscale_tailnet }}"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "min by (tailscale_collector, tailscale_tailnet) (tailscale2otel_subrequest_coverage_ratio)",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  1
                ],
                "type": "lt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "15m0s",
    "labels": {
      "domain": "observability",
      "service": "tailscale2otel",
      "severity": "warning",
      "skipinvestigation": "true"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "Subrequest coverage incomplete",
    "trigger": {
      "interval": "1m"
    }
  }
}
