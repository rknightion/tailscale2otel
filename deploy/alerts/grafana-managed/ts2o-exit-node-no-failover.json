{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-exit-node-no-failover"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel-tailnet",
      "__panelId__": "82",
      "description": "count(tailscale_subnet_routes_routers_ratio == 1) > 0 \u2014 one or more CIDRs are advertised by exactly one router, so there is no failover if it goes offline. Add a second subnet router.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#subnet-routing-and-services",
      "summary": "A subnet/CIDR is served by a single router (no failover)"
    },
    "execErrState": "Ok",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "count(tailscale_subnet_routes_routers_ratio == 1)",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "30m0s",
    "labels": {
      "domain": "infra",
      "service": "tailscale2otel",
      "severity": "info",
      "skipinvestigation": "true"
    },
    "noDataState": "Ok",
    "paused": true,
    "title": "Subnet route has no failover",
    "trigger": {
      "interval": "1m"
    }
  }
}
