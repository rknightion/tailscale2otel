{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-objectstore-export-stale"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel-overview",
      "__panelId__": "384",
      "description": "discovered.newest.age is how fresh the EXPORT's own writes are, independent of whether anything was ingested \u2014 objects skipped as already-ingested still count, so a caught-up feed keeps reporting a small age. Over an hour means Tailscale has stopped writing, or the configured prefix/credentials no longer see what it writes. The expression folds the -1 sentinel (nothing timestamped was listed at all) to a day of staleness on purpose: -1 is NOT an age, and a naive threshold would exclude the very case where discovery has stopped entirely.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#object-store-ingestion",
      "summary": "No recently-written object has been discovered in the bucket"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "max(clamp_min(last_over_time(tailscale2otel_objectstore_discovered_newest_age_seconds[10m]), 0) + 86400 * (last_over_time(tailscale2otel_objectstore_discovered_newest_age_seconds[10m]) == bool -1))",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  3600
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "30m0s",
    "labels": {
      "domain": "observability",
      "service": "tailscale2otel",
      "severity": "warning",
      "skipinvestigation": "true"
    },
    "noDataState": "Ok",
    "paused": true,
    "title": "Object-store export stale",
    "trigger": {
      "interval": "1m"
    }
  }
}
