{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-audit-config-change-warn"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel-tailnet",
      "__panelId__": "168",
      "description": "A tailscale.config.audit log was emitted at WARN (the change carried an error) in the last 10m. Inspect the Configuration audit row on the Security & Audit tab.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#audit-events",
      "summary": "Configuration-audit event carried an error"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-logs",
        "model": {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"tailscale2otel\"} | event_name=`tailscale.config.audit` | severity_text=`WARN` [10m]))",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "queryType": "range",
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "5m0s",
    "labels": {
      "domain": "security",
      "service": "tailscale2otel",
      "severity": "warning"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "Audit config change (WARN)",
    "trigger": {
      "interval": "1m"
    }
  }
}
