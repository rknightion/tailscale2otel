{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-ingest-data-stale"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel",
      "__panelId__": "162",
      "description": "The receiver or poller may still be running, but the newest accepted event timestamp is over one hour old. This rule ships paused because quiet tailnets and sparse webhook/audit sources are legitimately idle; enable it only for source/signal pairs expected to deliver continuously, and add label filters or tune the threshold for that workload.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#ingest-receivers",
      "summary": "Accepted {{ $labels.source }}/{{ $labels.signal }} events are over 1h stale"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "clamp_min(time() - max by (source, signal) (last_over_time(tailscale2otel_ingest_last_event_timestamp_seconds[30d])), 0)",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "720h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  3600
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "15m0s",
    "labels": {
      "domain": "observability",
      "service": "tailscale2otel",
      "severity": "warning",
      "skipinvestigation": "true"
    },
    "noDataState": "Ok",
    "paused": true,
    "title": "Accepted ingest data stale",
    "trigger": {
      "interval": "1m"
    }
  }
}
