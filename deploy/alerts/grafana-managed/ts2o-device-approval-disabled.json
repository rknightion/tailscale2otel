{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-device-approval-disabled"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel-overview",
      "__panelId__": "333",
      "description": "tailscale_setting_enabled_ratio{tailscale_setting_name=\"devices_approval\"} == 0 \u2014 new devices can join the tailnet without manual admin approval. Ships PAUSED because device approval is off by default in Tailscale and many tailnets run that way intentionally; enable this alert if your tailnet requires device approval. Absent (=> not firing) when the settings collector is disabled.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#tailnet-settings-drift",
      "summary": "Tailnet device approval is disabled"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "min(tailscale_setting_enabled_ratio{tailscale_setting_name=\"devices_approval\"})",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  1
                ],
                "type": "lt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "30m0s",
    "labels": {
      "domain": "security",
      "service": "tailscale2otel",
      "severity": "warning",
      "skipinvestigation": "true"
    },
    "noDataState": "Ok",
    "paused": true,
    "title": "Device approval disabled",
    "trigger": {
      "interval": "1m"
    }
  }
}
