{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "RecordingRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-rec-keys-expiring-7d"
  },
  "spec": {
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "count((max by (host_id) (tailscale_device_key_expiry_seconds) - time() < 7*86400) and (max by (host_id) (tailscale_device_key_expiry_seconds) - time() > 0))",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        },
        "source": true
      }
    },
    "labels": {
      "domain": "security",
      "service": "tailscale2otel"
    },
    "metric": "tailscale:device_keys_expiring_7d:count",
    "paused": true,
    "targetDatasourceUID": "grafanacloud-prom",
    "title": "tailscale:device_keys_expiring_7d:count",
    "trigger": {
      "interval": "1m"
    }
  }
}
