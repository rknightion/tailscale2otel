{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "tailscale2otel"
    },
    "labels": {
      "grafana.app/folder": "tailscale2otel"
    },
    "name": "ts2o-heap-near-memory-limit"
  },
  "spec": {
    "annotations": {
      "__dashboardUid__": "tailscale2otel-health",
      "__panelId__": "133",
      "description": "Allocated heap has exceeded 90% of the effective Go soft memory limit for 10 minutes. The comparison pairs heap and limit from the same process; unlimited (-1), zero and missing limits do not alert. Go-managed non-heap memory also consumes the limit. Inspect heap retention and ingestion backlog before adjusting GOMEMLIMIT or container memory.",
      "runbook_url": "https://m7kni.io/tailscale2otel/runbooks/#exporter-internal-errors",
      "summary": "Go heap is near its effective memory limit"
    },
    "execErrState": "Error",
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-prom",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "tailscale2otel_runtime_memory_heap_alloc_bytes / (tailscale2otel_runtime_memory_limit_bytes > 0)",
          "instant": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": false,
          "refId": "A"
        },
        "relativeTimeRange": {
          "from": "1h0m0s",
          "to": "0s"
        }
      },
      "B": {
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "B",
          "type": "reduce"
        }
      },
      "C": {
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0.9
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": []
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "B",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C",
          "type": "threshold"
        },
        "source": true
      }
    },
    "for": "10m0s",
    "labels": {
      "domain": "observability",
      "service": "tailscale2otel",
      "severity": "warning",
      "skipinvestigation": "true"
    },
    "noDataState": "Ok",
    "paused": false,
    "title": "Heap near Go memory limit",
    "trigger": {
      "interval": "1m"
    }
  }
}
