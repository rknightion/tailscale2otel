#!/usr/bin/env bash
#
# Keep committed generated artifacts in sync with their sources, so a hand-edit
# (e.g. bumping Chart.yaml without regenerating README.md) never lands a commit
# that CI's fail-on-diff gates will reject.
#
# It only does work when your *staged* changes touch an artifact's inputs, then
# regenerates and re-stages that artifact so it's committed atomically with the
# change. Scoped this way the hook is a no-op (and silent) on the vast majority
# of commits.
#
# Every command here goes through `just`, which is this repo's only supported task
# surface — the hook must never be a second, divergent definition of how an
# artifact is regenerated.
#
# Enable once per clone (it is NOT installed automatically):
#   git config core.hooksPath .githooks
#
# Bypass for a single commit if ever needed: git commit --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Staged paths. DELETIONS COUNT: removing an input is as much a change to a
# generated artifact as editing one — deleting a file under internal/config/
# changes config.schema.json, and an ACMR-only filter let that land stale.
# --name-status is used rather than --name-only so a RENAME contributes BOTH its
# old and new path; a file moved OUT of an input directory still invalidates the
# artifact it used to feed, and the new path alone cannot show that.
staged="$(git diff --cached --name-status --diff-filter=ACMRD | awk -F'\t' '{ for (i = 2; i <= NF; i++) if ($i != "") print $i }')"
[ -z "$staged" ] && exit 0

# Decide which generated artifacts the staged changes could have invalidated.
helm_inputs='^deploy/helm/tailscale2otel/(Chart\.yaml|values\.yaml|README\.md\.gotmpl)$'
metrics_inputs='(^internal/.*\.go$|^tools/metricscatalog/)'
envref_inputs='(^config\.example\.yaml$|^internal/config/envref\.go$)'
# Only the manifest and the renderer — NOT the catalog at large. Adding or
# pruning manifest rows is a decision, so that stays a hand-run -update; this
# just keeps the published page matching whatever the manifest already says.
coverage_inputs='^internal/catalog/(signal_dispositions\.json|dispositions\.go)$'
# config.schema.json is derived from the Config struct AND config.example.yaml, so
# any change under internal/config can invalidate it — not just the example file.
# Its drift gate is TestConfigSchemaInSync inside the normal `go test` run, which
# means a stale file fails the SUITE rather than a dedicated workflow step.
cfgschema_inputs='(^config\.example\.yaml$|^internal/config/)'

targets=()
git_add=()
if grep -Eq "$helm_inputs" <<<"$staged"; then
  targets+=(helm)
  git_add+=(deploy/helm/tailscale2otel/README.md deploy/helm/tailscale2otel/values.schema.json)
fi
if grep -Eq "$metrics_inputs" <<<"$staged"; then
  targets+=(metrics)
  git_add+=(docs/metrics.md)
fi
if grep -Eq "$envref_inputs" <<<"$staged"; then
  targets+=(envref)
  git_add+=(docs/env-vars.md)
fi
if grep -Eq "$coverage_inputs" <<<"$staged"; then
  targets+=(coverage)
  git_add+=(docs/signal-coverage.md)
fi
if grep -Eq "$cfgschema_inputs" <<<"$staged"; then
  targets+=(config-schema)
  git_add+=(config.schema.json)
fi

[ ${#targets[@]} -eq 0 ] && exit 0

if ! command -v just >/dev/null 2>&1; then
  echo "pre-commit: just not on PATH — skipping regen (CI will gate). Install it: brew install just" >&2
  exit 0
fi

echo "pre-commit: regenerating generated artifacts (${targets[*]})"
just gen "${targets[@]}"

# Re-stage anything regeneration touched so it's committed atomically, then
# report which artifacts actually changed vs HEAD (so the commit's new contents
# are no surprise).
git add -- "${git_add[@]}" 2>/dev/null || true
for f in "${git_add[@]}"; do
  if [ -e "$f" ] && ! git diff --cached --quiet HEAD -- "$f" 2>/dev/null; then
    echo "pre-commit: re-staged regenerated $f"
  fi
done

exit 0
