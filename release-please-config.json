{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "package-name": "tailscale2otel",
      "extra-files": [
        {
          "type": "generic",
          "path": "deploy/docker-compose.yaml"
        },
        {
          "type": "generic",
          "path": "deploy/alloy/docker-compose.yaml"
        },
        {
          "type": "generic",
          "path": "deploy/helm/tailscale2otel/Chart.yaml"
        }
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build System",
      "hidden": true
    }
  ]
}
