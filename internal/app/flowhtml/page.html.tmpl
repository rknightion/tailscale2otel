<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.ServiceName}} — flows</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='6' fill='%234493f8'/%3E%3C/svg%3E">
<style>
  /* Shared palette with the status page so the two read as one surface. */
  :root{
    --bg:#0f1419; --panel:#171c24; --panel2:#1d242e; --line:#2a323d;
    --fg:#e6edf3; --muted:#8b98a5; --accent:#4493f8;
    --ok:#3fb950; --warn:#d29922; --err:#f85149; --pending:#6e7681;
    --grid:#242c37;
    --tx:#4493f8; --rx:#3fb950;
    --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  }
  @media (prefers-color-scheme: light){
    :root:not([data-theme]){
      --bg:#f6f8fa; --panel:#ffffff; --panel2:#f0f3f6; --line:#d0d7de;
      --fg:#1f2328; --muted:#59636e; --accent:#0969da;
      --ok:#1a7f37; --warn:#9a6700; --err:#cf222e; --pending:#8c959f;
      --grid:#e6eaef; --tx:#0969da; --rx:#1a7f37;
    }
  }
  :root[data-theme="light"]{
    --bg:#f6f8fa; --panel:#ffffff; --panel2:#f0f3f6; --line:#d0d7de;
    --fg:#1f2328; --muted:#59636e; --accent:#0969da;
    --ok:#1a7f37; --warn:#9a6700; --err:#cf222e; --pending:#8c959f;
    --grid:#e6eaef; --tx:#0969da; --rx:#1a7f37;
  }
  :root[data-theme="dark"]{
    --bg:#0f1419; --panel:#171c24; --panel2:#1d242e; --line:#2a323d;
    --fg:#e6edf3; --muted:#8b98a5; --accent:#4493f8;
    --ok:#3fb950; --warn:#d29922; --err:#f85149; --pending:#6e7681;
    --grid:#242c37; --tx:#4493f8; --rx:#3fb950;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--fg);
    font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  a{color:var(--accent);text-decoration:none}
  a:hover{text-decoration:underline}
  code{font-family:var(--mono);font-size:12px;background:var(--panel2);padding:1px 5px;border-radius:4px}
  header{padding:16px 24px;border-bottom:1px solid var(--line);
    display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
  header h1{margin:0;font-size:19px;font-weight:600}
  header .ver{color:var(--muted);font-family:var(--mono);font-size:13px}
  header .spacer{flex:1}
  main{max-width:1320px;margin:0 auto;padding:18px 24px 60px}
  section{margin:0 0 24px}
  section>h2{font-size:13px;text-transform:uppercase;letter-spacing:.06em;
    color:var(--muted);margin:0 0 10px;font-weight:600;display:flex;align-items:baseline;gap:10px}
  section>h2 .hint{text-transform:none;letter-spacing:normal;font-weight:400;font-size:12px}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:10px}
  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px 14px}
  .card .k{color:var(--muted);font-size:12px;margin-bottom:5px}
  .card .v{font-size:19px;font-weight:600;font-variant-numeric:tabular-nums}
  .card .sub{color:var(--muted);font-size:12px;margin-top:3px;font-family:var(--mono);overflow-wrap:anywhere}
  .card.warn2{border-color:var(--warn)}
  /* Controls */
  .controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:18px;
    padding:11px 14px;background:var(--panel);border:1px solid var(--line);border-radius:10px}
  .controls label{color:var(--muted);font-size:12px}
  button.ctl,select.ctl,input.ctl{background:var(--panel2);color:var(--fg);border:1px solid var(--line);
    border-radius:7px;padding:4px 10px;font-size:12px;font-family:inherit;cursor:pointer}
  input.ctl{cursor:text}
  button.ctl:hover,select.ctl:hover{border-color:var(--accent)}
  button.ctl[aria-pressed="true"]{border-color:var(--accent);color:var(--accent)}
  .seg{display:inline-flex;border:1px solid var(--line);border-radius:7px;overflow:hidden}
  .seg button{background:var(--panel2);color:var(--fg);border:0;border-right:1px solid var(--line);
    padding:4px 11px;font-size:12px;font-family:inherit;cursor:pointer}
  .seg button:last-child{border-right:0}
  .seg button[aria-pressed="true"]{background:var(--accent);color:#fff}
  .spacer{flex:1}
  /* Banners */
  .banner{display:none;padding:8px 24px;font-size:13px;border-bottom:1px solid var(--line)}
  .banner.show{display:block}
  #errBanner{background:rgba(248,81,73,.16);color:var(--err)}
  #truncBanner{background:rgba(210,153,34,.16);color:var(--warn)}
  /* Tables */
  table{width:100%;border-collapse:collapse;background:var(--panel);
    border:1px solid var(--line);border-radius:10px;overflow:hidden}
  th,td{text-align:left;padding:7px 11px;border-bottom:1px solid var(--line);
    font-variant-numeric:tabular-nums;vertical-align:top}
  th{color:var(--muted);font-size:12px;font-weight:600;background:var(--panel2)}
  tr:last-child td{border-bottom:0}
  td.num{text-align:right;font-family:var(--mono);font-size:12px;white-space:nowrap}
  td.mono{font-family:var(--mono);font-size:12px;overflow-wrap:anywhere}
  tbody tr.pick{cursor:pointer}
  tbody tr.pick:hover{background:var(--panel2)}
  tbody tr.pick:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
  tbody tr.sel{background:rgba(68,147,248,.12)}
  /* Focus-visible: keyboard focus always gets a visible ring; a mouse click
     alone does not. Covers the newly keyboard-operable topology nodes, matrix
     cells and pickable table rows, plus every ordinary control. */
  :focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  @media (prefers-reduced-motion: reduce){
    *{scroll-behavior:auto!important}
  }
  .empty{color:var(--muted);font-size:13px;padding:14px;text-align:center}
  .grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(400px,1fr));gap:18px}
  .grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:18px}
  /* Charts */
  svg{display:block}
  .chart{width:100%;height:150px}
  .chart-wrap{position:relative;background:var(--panel);border:1px solid var(--line);
    border-radius:10px;padding:10px 12px}
  .legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-top:5px}
  .legend .lg{display:inline-flex;align-items:center;gap:5px}
  .legend .sw{width:10px;height:3px;border-radius:2px;display:inline-block}
  .tip{position:fixed;display:none;pointer-events:none;background:var(--panel2);
    border:1px solid var(--line);border-radius:6px;padding:5px 8px;font-size:11px;
    font-family:var(--mono);white-space:pre;z-index:40;box-shadow:0 4px 14px rgba(0,0,0,.35)}
  /* Topology */
  #topoWrap{position:relative;background:var(--panel);border:1px solid var(--line);
    border-radius:10px;overflow:hidden}
  #topo{width:100%;height:460px;cursor:grab;touch-action:none}
  #topo.drag{cursor:grabbing}
  #topo .edge{stroke:var(--muted);stroke-opacity:.35;fill:none}
  #topo .edge.hi{stroke:var(--accent);stroke-opacity:.9}
  #topo .edge.dim{stroke-opacity:.06}
  #topo .node{fill:var(--accent);stroke:var(--panel);stroke-width:1.5}
  #topo .node.sel{stroke:var(--fg);stroke-width:2.5}
  #topo .node:focus-visible{outline:2px solid var(--fg);outline-offset:2px}
  #topo .node.dim{opacity:.2}
  #topo .node.ext{fill:var(--pending)}
  #topo .lbl{fill:var(--fg);font-size:10px;font-family:var(--mono);pointer-events:none;
    paint-order:stroke;stroke:var(--panel);stroke-width:3px;stroke-linejoin:round}
  #topo .lbl.dim{opacity:.18}
  .topo-note{position:absolute;right:10px;bottom:8px;color:var(--muted);font-size:11px;
    pointer-events:none}
  /* Breakdown bars */
  .bars{padding:4px 0}
  .bar{display:grid;grid-template-columns:minmax(84px,26%) 1fr auto;gap:9px;align-items:center;
    padding:4px 12px;font-size:12px}
  .bar .bn{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--mono)}
  .bar .bt{height:8px;background:var(--panel2);border-radius:4px;overflow:hidden}
  .bar .bf{height:100%;background:var(--accent);border-radius:4px}
  .bar .bv{color:var(--muted);font-family:var(--mono);font-variant-numeric:tabular-nums}
  /* Identity matrix */
  .matrix{overflow:auto;padding:12px}
  .matrix table{border:0;background:transparent;width:auto;border-radius:0}
  .matrix th,.matrix td{border:0;padding:2px;background:transparent}
  .matrix th{font-family:var(--mono);font-weight:400;font-size:11px;color:var(--muted);
    white-space:nowrap;position:static}
  .matrix th.rowh{text-align:right;padding-right:9px;max-width:190px;overflow:hidden;
    text-overflow:ellipsis}
  .matrix th.colh{writing-mode:vertical-rl;transform:rotate(180deg);height:104px;
    vertical-align:bottom;max-height:104px;overflow:hidden}
  .matrix th.corner{font-size:10px;text-align:right;vertical-align:bottom;padding-right:9px}
  .cell{min-width:52px;height:26px;border-radius:4px;display:flex;align-items:center;
    justify-content:center;font-size:10px;font-family:var(--mono);cursor:pointer;
    background:var(--panel2);color:var(--muted);user-select:none}
  .cell.hot{color:#fff}
  .cell.sel{outline:2px solid var(--fg);outline-offset:-2px}
  .cell.zero{cursor:default;opacity:.35}
  .cell:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
  .coverage{color:var(--muted);font-size:12px;padding:0 12px 11px}
  .coverage b{color:var(--fg);font-weight:600}
  /* Policy reconciliation */
  .vstrip{display:flex;height:12px;border-radius:6px;overflow:hidden;
    margin:13px 12px 10px;background:var(--panel2)}
  .vstrip>div{height:100%;min-width:2px}
  .vlegend{display:flex;flex-wrap:wrap;gap:16px;padding:0 12px 11px;font-size:12px;color:var(--muted)}
  .vlegend>span{display:flex;align-items:center;gap:6px;cursor:help}
  .vlegend .sw{width:9px;height:9px;border-radius:2px;flex:none}
  .vlegend b{color:var(--fg);font-weight:600;font-variant-numeric:tabular-nums}
  .rulesrc{font-family:var(--mono);font-size:11px;overflow-wrap:anywhere}
  .verdict{font-size:11px;font-family:var(--mono);white-space:nowrap}
  .verdict.permitted{color:var(--ok)} .verdict.permitted_reverse{color:var(--accent)}
  .verdict.no_rule{color:var(--warn)} .verdict.undetermined{color:var(--muted)}
  /* Flow list */
  .ident{display:block;color:var(--muted);font-size:11px;margin-top:2px}
  #flowList{max-height:460px;overflow:auto}
  #flowList table{border:0;border-radius:0}
  #flowList th{position:sticky;top:0;z-index:1}
  .pill{display:inline-block;padding:1px 7px;border-radius:999px;font-size:11px;
    background:var(--panel2);color:var(--muted);font-family:var(--mono)}
  .pill.virtual{color:var(--accent)} .pill.subnet{color:var(--ok)}
  .pill.exit{color:var(--warn)} .pill.physical{color:var(--muted)}
  .filtered{color:var(--accent);font-size:12px}
  .foot{color:var(--muted);font-size:12px;margin-top:26px;text-align:center}
  <!-- Without JS nothing on this page can be drawn; say so rather than showing an empty frame. -->
</style>
<noscript><style>
  main>section{display:none}
  #noJS{display:block!important}
</style></noscript>
<script>
  // Apply the persisted theme BEFORE first paint. Shares the status page's key so
  // the two surfaces agree.
  (function(){try{var t=localStorage.getItem('ts2otel-theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();
</script>
</head>
<body>
<header>
  <h1>{{.ServiceName}} <span style="color:var(--muted);font-weight:400">flows</span></h1>
  <span class="ver">{{.Version}}</span>
  <span class="ver">retention {{.Retention}}</span>
  <span class="spacer"></span>
  <a href="/">status &rarr;</a>
  <button class="ctl" id="themeToggle" title="Toggle light/dark theme" aria-label="Toggle theme">&#9686;</button>
</header>
<div class="banner" id="errBanner" role="alert"></div>
<div class="banner" id="truncBanner" role="status"></div>

<main>
<p id="noJS" style="display:none" class="empty">
  This view is drawn in the browser from <code>/api/flows.json</code>. With JavaScript disabled,
  query that endpoint directly — it returns the same data as JSON.
</p>

<div class="controls">
  <label for="winSel">Window</label>
  <div class="seg" id="winSeg">
    <button data-win="15m">15m</button>
    <button data-win="1h" aria-pressed="true">1h</button>
    <button data-win="6h">6h</button>
    <button data-win="24h">24h</button>
  </div>
  <span id="tailnetWrap" style="display:none">
    <label for="tnSel">Tailnet</label>
    <select class="ctl" id="tnSel"></select>
  </span>
  <label for="topSel">Top</label>
  <select class="ctl" id="topSel">
    <option>10</option><option selected>20</option><option>50</option><option>100</option>
  </select>
  <button class="ctl" id="liveBtn" aria-pressed="true" title="Follow the newest data">&#9679; live</button>
  <button class="ctl" id="nowBtn" style="display:none" title="Return to the newest data">jump to now</button>
  <span class="spacer"></span>
  <span class="ver" id="covered"></span>
  <button class="ctl" id="refreshBtn" title="Fetch now">refresh</button>
</div>

<section>
  <div class="cards" id="cards"></div>
</section>

<section>
  <h2>Traffic over time <span class="hint">drag on the chart to zoom into a span &middot; double-click to reset</span></h2>
  <div class="chart-wrap">
    <svg class="chart" id="timeline" preserveAspectRatio="none" role="img" aria-label="Traffic over time"></svg>
    <div class="legend">
      <span class="lg"><i class="sw" style="background:var(--tx)"></i>transmitted</span>
      <span class="lg"><i class="sw" style="background:var(--rx)"></i>received</span>
    </div>
  </div>
</section>

<section>
  <h2>Topology <span class="hint" id="topoHint"></span></h2>
  <div id="topoWrap">
    <svg id="topo" role="img" aria-label="Device topology graph"></svg>
    <div class="topo-note">drag a device to reposition &middot; click to filter &middot; click empty space to clear</div>
  </div>
</section>

<section class="grid3">
  <div>
    <h2>Traffic type</h2>
    <div class="panel bars" id="barsTrafficTypes"></div>
  </div>
  <div>
    <h2>Transport</h2>
    <div class="panel bars" id="barsTransports"></div>
  </div>
  <div>
    <h2>Operating system <span class="hint">destination side only</span></h2>
    <div class="panel bars" id="barsOSes"></div>
  </div>
</section>

<section class="grid2">
  <div>
    <h2>Top devices</h2>
    <div id="tblNodes"></div>
  </div>
  <div>
    <h2>Top conversations</h2>
    <div id="tblPairs"></div>
  </div>
</section>

<section class="grid3">
  <div>
    <h2>Destination services <span class="hint">overlay traffic only</span></h2>
    <div id="tblPorts"></div>
  </div>
  <div>
    <h2>Users</h2>
    <div class="panel bars" id="barsUsers"></div>
  </div>
  <div>
    <h2>Tags</h2>
    <div class="panel bars" id="barsTags"></div>
  </div>
</section>

<section>
  <h2>Who talks to whom
    <span class="hint">a cell is one direction &middot; click to filter the connection list</span>
  </h2>
  <div class="controls" style="margin-bottom:10px">
    <label>By</label>
    <!-- No operating-system matrix: flow records carry `os` on the destination
         endpoint only (0 of 18,702 source nodes in a live capture), so an OS
         matrix could only ever be empty. -->
    <div class="seg" id="matrixSeg">
      <button data-kind="tag" aria-pressed="true">Tag</button>
      <button data-kind="user">User</button>
    </div>
    <span class="spacer"></span>
    <button class="ctl" id="matrixClear" style="display:none">clear cell filter</button>
  </div>
  <div class="panel">
    <div class="matrix" id="matrix"></div>
    <div class="coverage" id="matrixCoverage"></div>
  </div>
</section>

<section>
  <h2>Policy reconciliation
    <span class="hint">what the tailnet&rsquo;s ACL says about the traffic above</span>
  </h2>
  <div class="panel">
    <div class="vstrip" id="policyStrip"></div>
    <div class="vlegend" id="policyLegend"></div>
    <div class="coverage" id="policyNote"></div>
  </div>
</section>

<section class="grid2">
  <div>
    <h2>Traffic no rule explains <span class="hint" id="unexplainedCount"></span></h2>
    <div id="tblUnexplained"></div>
    <div class="coverage" id="unexplainedNote"></div>
  </div>
  <div>
    <h2>Rules that permitted nothing <span class="hint" id="unexercisedWindow"></span></h2>
    <div id="tblUnexercised"></div>
    <div class="coverage" id="unexercisedNote"></div>
  </div>
</section>

<section class="grid2">
  <div>
    <h2>How peers are reached
      <span class="hint">the underlay path, by connections, not bytes</span>
    </h2>
    <div class="panel">
      <div class="vstrip" id="pathStrip"></div>
      <div class="vlegend" id="pathLegend"></div>
      <div class="vlegend" id="derpRegions"></div>
      <div class="coverage" id="pathNote"></div>
    </div>
  </div>
  <div>
    <h2>Peers being relayed <span class="hint" id="peerPathCount"></span></h2>
    <div id="tblPeerPaths"></div>
    <div class="coverage" id="peerPathNote"></div>
  </div>
</section>

<section>
  <h2>Recent connections <span class="hint" id="flowCount"></span></h2>
  <p class="coverage">
    <b>Verified reporter</b> is the node ID authenticated by Tailscale's log service; trust uses only
    the configured reporter allowlist and authoritative device tags. Field presence is
    <b>observed completeness</b>, not proof of the tailnet's Destination Logging configuration:
    missing destination or port fields can be expected privacy-driven omissions.
  </p>
  <p class="coverage">
    The filters below run on the server against the FULL retained ring, not just the rows already on
    screen — a match outside the current page is reached by <b>load more</b>, not lost (#296).
  </p>
  <div class="controls" style="margin-bottom:10px; flex-wrap:wrap">
    <label for="filterDevice">Device</label>
    <input class="ctl" id="filterDevice" type="search" placeholder="node name" style="width:130px">
    <label for="filterAddr">Address</label>
    <input class="ctl" id="filterAddr" type="search" placeholder="ip or port" style="width:120px">
    <label for="filterService">Service</label>
    <input class="ctl" id="filterService" type="search" placeholder="e.g. https" style="width:100px">
    <label for="filterIdentity">Identity</label>
    <input class="ctl" id="filterIdentity" type="search" placeholder="user or tag" style="width:120px">
    <label for="filterType">Type</label>
    <select class="ctl" id="filterType">
      <option value="">any</option>
      <option value="virtual">virtual</option>
      <option value="subnet">subnet</option>
      <option value="exit">exit</option>
      <option value="physical">physical</option>
    </select>
    <label for="filterVerdict">Verdict</label>
    <select class="ctl" id="filterVerdict">
      <option value="">any</option>
      <option value="permitted">permitted</option>
      <option value="no_rule">no_rule</option>
      <option value="undetermined">undetermined</option>
    </select>
    <label for="filterPath">Path</label>
    <select class="ctl" id="filterPath">
      <option value="">any</option>
      <option value="direct">direct</option>
      <option value="derp">derp</option>
    </select>
    <button class="ctl" id="flowClear">clear filters</button>
  </div>
  <div class="panel" id="flowList"></div>
  <p class="coverage" id="flowPageNote"></p>
  <div class="controls" style="justify-content:center">
    <button class="ctl" id="flowLoadMore" style="display:none">load more</button>
    <a class="ctl" id="exportCsv" href="/api/flows/export.csv">export CSV</a>
    <a class="ctl" id="exportJson" href="/api/flows/export.json">export JSON</a>
  </div>
  <p class="coverage">
    Export applies the SAME window and filters as the table above (#299), drawn from the same
    bounded recent-connection ring this whole view is — never persistent full history. Each file
    states its own window, filters, and matched/returned/retained counts, so it is honest about
    what it does and doesn&rsquo;t cover even once it has left this page.
  </p>
</section>

<p class="foot">
  Aggregated in memory over the last {{.Retention}} and lost on restart — the OTLP backend remains the
  system of record. Identity is shown in full: <code>pii_filter</code> governs exported telemetry, not
  this page.
</p>
</main>

<div class="tip" id="tip"></div>

<script>
"use strict";
var TAILNETS = {{.Tailnets}};
var TAILNET  = {{.Tailnet}};
var REFRESH_MS = {{if .RefreshMs}}{{.RefreshMs}}{{else}}5000{{end}};
var SVGNS = "http://www.w3.org/2000/svg";

// ---------------------------------------------------------------- utilities

function el(id){ return document.getElementById(id); }

function svgEl(name, attrs){
  var n = document.createElementNS(SVGNS, name);
  for (var k in attrs) if (attrs[k] !== null && attrs[k] !== undefined) n.setAttribute(k, attrs[k]);
  return n;
}

function clear(node){ while (node.firstChild) node.removeChild(node.firstChild); }

// fmtBytes uses binary units, matching how an operator reads a link's capacity.
function fmtBytes(n){
  n = n || 0;
  if (n < 1024) return n + " B";
  var u = ["KiB","MiB","GiB","TiB","PiB"], i = -1;
  do { n /= 1024; i++; } while (n >= 1024 && i < u.length - 1);
  return (n < 10 ? n.toFixed(2) : n < 100 ? n.toFixed(1) : Math.round(n)) + " " + u[i];
}

function fmtNum(n){
  n = n || 0;
  if (n < 1000) return String(n);
  if (n < 1e6) return (n/1e3).toFixed(n < 1e4 ? 1 : 0) + "k";
  if (n < 1e9) return (n/1e6).toFixed(n < 1e7 ? 1 : 0) + "M";
  return (n/1e9).toFixed(1) + "G";
}

// Go's zero time marshals as year 1. It means "never" — an empty store, a window
// nothing has landed in — so it must never be formatted as a date in antiquity.
function isZeroTime(iso){ return !iso || String(iso).indexOf("0001-01-01") === 0; }

function fmtTime(iso){
  if (isZeroTime(iso)) return "—";
  var d = new Date(iso);
  if (isNaN(d.getTime())) return "—";
  return d.toLocaleTimeString([], {hour:"2-digit", minute:"2-digit", second:"2-digit"});
}

function fmtClock(iso){
  if (isZeroTime(iso)) return "—";
  var d = new Date(iso);
  if (isNaN(d.getTime())) return "—";
  return d.toLocaleString([], {month:"short", day:"numeric", hour:"2-digit", minute:"2-digit"});
}

function bytes(c){ return (c && (c.tx_bytes + c.rx_bytes)) || 0; }

// fmtShort is fmtBytes for a matrix cell, where there is room for four
// characters and not one more.
function fmtShort(n){
  n = n || 0;
  if (n < 1000) return String(n);
  var u = ["K","M","G","T","P"], i = -1;
  do { n /= 1024; i++; } while (n >= 1024 && i < u.length - 1);
  return (n < 10 ? n.toFixed(1) : Math.round(n)) + u[i];
}

// Tags travel as the comma-joined set the record carried, so membership is a
// list test, not a string compare — "tag:prod" must not match "tag:production".
function hasTag(joined, tag){
  if (!joined) return false;
  return joined.split(",").some(function(t){ return t.trim() === tag; });
}

// OTHER is the sentinel the store folds overflow into; it is a bucket, not a
// device, so it is never drawn as a topology vertex.
var OTHER = "__other__";

function label(name){ return name === OTHER ? "other (truncated)" : name; }

// ------------------------------------------------------------------- state

var state = {
  window: "1h",
  top: 20,
  tailnet: TAILNET,
  end: null,          // null == follow the newest data
  selected: null,     // a device name, or null
  matrixKind: "tag",  // which identity matrix is on screen
  cell: null,         // {src, dst} from a clicked matrix cell, or null
  // filters mirror the server-side RecentFilter dimensions (#296): the
  // server now does the matching against the FULL retained ring, not just
  // whatever page happened to be on screen, so a match outside the visible
  // rows is reached via load-more instead of being invisible.
  filters: {device:"", addr:"", service:"", identity:"", type:"", verdict:"", path:""},
  // recentExtra holds rows fetched via "load more", appended after the
  // current poll's own Recent page. Reset on every fresh poll (a new poll
  // always restarts pagination from page 1).
  recentExtra: [],
  data: null,
  timer: null,
  positions: {}       // topology layout, kept across polls so it does not jump
};

// ------------------------------------------------------------- shareable URLs

// FILTER_KEYS names the seven server-side RecentFilter dimensions, in the
// vocabulary /api/flows.json already uses. The page URL reuses the SAME
// names (#298) rather than growing a second vocabulary next to it.
var FILTER_KEYS = ["device", "addr", "service", "identity", "type", "verdict", "path"];

// GO_DURATION matches the subset of time.ParseDuration's grammar this page
// ever produces or accepts back: one or more integer-then-unit pairs (the
// preset buttons emit "15m"/"1h"/"6h"/"24h"; the timeline brush emits
// "<n>s"). A window from a hand-edited or stale URL that does not match this
// is a value the SERVER would only have to guess at too (admin_flows.go's
// clampDuration falls back the same way on empty/unparseable input) — fail
// safe by not sending it at all, rather than forwarding something odd.
var GO_DURATION_RE = /^([0-9]+(ns|us|µs|ms|s|m|h))+$/;

function validWindow(s){ return typeof s === "string" && GO_DURATION_RE.test(s); }

// urlFromState renders the page's current view as URLSearchParams, so a
// shared link reproduces the window, the pinned end, the tailnet, the
// selected device, the matrix mode/cell and all seven filters (#298).
//
// It carries ONLY that view state. It must never carry admin.auth.token —
// the browser holds that as a Basic/Bearer credential this JS never sees, so
// there is nothing here that even could leak it — and never the compiled
// policy TEXT, which is response data, not view state, and has no business
// living in an address bar, browser history, or a pasted link. See
// TestRender_ShareableURLBuilderNeverCarriesCredentialsOrPolicyText, which
// pins this by asserting the word "token" and the policy rule text never
// appear anywhere in this section of the page's own source.
function urlFromState(){
  var p = new URLSearchParams();
  p.set("window", state.window);
  if (state.end) p.set("end", state.end);
  if (state.tailnet) p.set("tailnet", state.tailnet);
  if (state.selected) p.set("selected", state.selected);
  if (state.matrixKind && state.matrixKind !== "tag") p.set("matrix", state.matrixKind);
  if (state.cell){
    p.set("cell_src", state.cell.src);
    p.set("cell_dst", state.cell.dst);
  }
  FILTER_KEYS.forEach(function(k){
    if (state.filters[k]) p.set(k, state.filters[k]);
  });
  return p;
}

// syncURL writes state into the address bar. push=true adds a history entry
// (selecting a device, changing the window, picking a matrix cell — a real
// navigation a back button should undo one step at a time); push=false
// replaces the current entry (typing in a filter box) so the back button is
// not flooded with one entry per keystroke, which would make it as useless
// as having no history at all — the same bug in a different form (#298).
function syncURL(push){
  var qs = urlFromState().toString();
  var url = location.pathname + (qs ? "?" + qs : "");
  if (push) history.pushState({flowview: qs}, "", url);
  else history.replaceState({flowview: qs}, "", url);
  updateExportLinks();
}

// updateExportLinks keeps the export links' hrefs matching the page's own
// query params (#299), reusing the exact fetch query baseParams() already
// builds — a stale export link that silently drifted from what the table on
// screen shows would be worse than no link at all.
function updateExportLinks(){
  var qs = baseParams().toString();
  el("exportCsv").href = "/api/flows/export.csv" + (qs ? "?" + qs : "");
  el("exportJson").href = "/api/flows/export.json" + (qs ? "?" + qs : "");
}

// applyStateFromLocation reads the URL into state and the controls that show
// it. Called once at load (a fresh open, a paste, a bookmark) and again on
// every popstate (back/forward). Every value fails safe to the default view
// rather than an error or a blank screen: an unparseable window falls back
// to 1h, a future or unparseable end un-pins to live (a merely-too-old one is
// left to the SERVER's own clamp — admin_flows.go's clampTime — so it still
// degrades gracefully rather than being rejected twice), an unknown tailnet
// or matrix kind falls back to the default, and a stale selected device or
// matrix cell is dropped once the next poll's data says it no longer exists
// (see dropStaleSelection, called from render()).
function applyStateFromLocation(){
  var p = new URLSearchParams(location.search);

  var win = p.get("window");
  state.window = validWindow(win) ? win : "1h";

  var end = p.get("end");
  if (end){
    var d = new Date(end);
    state.end = (!isNaN(d.getTime()) && d.getTime() <= Date.now()) ? d.toISOString() : null;
  } else {
    state.end = null;
  }

  var tn = p.get("tailnet");
  state.tailnet = (tn && TAILNETS && TAILNETS.indexOf(tn) !== -1) ? tn : TAILNET;

  state.selected = p.get("selected") || null;

  var mk = p.get("matrix");
  state.matrixKind = (mk && MATRIX_KINDS[mk]) ? mk : "tag";

  var cellSrc = p.get("cell_src"), cellDst = p.get("cell_dst");
  state.cell = (cellSrc && cellDst) ? {src: cellSrc, dst: cellDst} : null;

  state.filters = {};
  FILTER_KEYS.forEach(function(k){
    var v = p.get(k) || "";
    // maxFlowsFilterLen (admin_flows.go): a longer value would only earn a
    // 400 from the server and wedge the page behind a permanent error
    // banner. Truncating here keeps a hand-edited or stale URL usable.
    state.filters[k] = v.length > 128 ? v.slice(0, 128) : v;
  });

  reflectControlsFromState();
}

// reflectControlsFromState pushes state into the controls that display it,
// so a restored URL (initial load or popstate) shows correctly pressed
// buttons and filled-in filter inputs instead of the markup's static
// defaults.
function reflectControlsFromState(){
  Array.prototype.forEach.call(document.querySelectorAll("#winSeg button"), function(b){
    b.setAttribute("aria-pressed", b.getAttribute("data-win") === state.window ? "true" : "false");
  });
  Array.prototype.forEach.call(document.querySelectorAll("#matrixSeg button"), function(b){
    b.setAttribute("aria-pressed", b.getAttribute("data-kind") === state.matrixKind ? "true" : "false");
  });
  el("matrixClear").style.display = state.cell ? "" : "none";
  setLive(!state.end);
  if (el("tnSel")) el("tnSel").value = state.tailnet;
  var filterFieldIds = {
    device: "filterDevice", addr: "filterAddr", service: "filterService",
    identity: "filterIdentity", type: "filterType", verdict: "filterVerdict", path: "filterPath"
  };
  Object.keys(filterFieldIds).forEach(function(k){
    var input = el(filterFieldIds[k]);
    if (input) input.value = state.filters[k] || "";
  });
}

// dropStaleSelection clears a selected device or matrix cell the just-arrived
// data no longer contains — a shared URL naming a device that has since left
// the tailnet, or a cell from a window/kind combination that no longer
// produces it — so the view degrades to the default (whole-tailnet) picture
// instead of silently filtering everything down to nothing forever (#298).
function dropStaleSelection(d){
  if (state.selected){
    var known = (d.result.nodes || []).some(function(n){ return n.node === state.selected; });
    if (!known){ state.selected = null; syncURL(false); }
  }
  if (state.cell){
    var kind = MATRIX_KINDS[state.matrixKind];
    var all = d.result[kind.field] || [];
    var known2 = all.some(function(c){ return c.src === state.cell.src && c.dst === state.cell.dst; });
    if (!known2){
      state.cell = null;
      el("matrixClear").style.display = "none";
      syncURL(false);
    }
  }
}

// ------------------------------------------------------------------ fetching

// baseParams builds the query params every /api/flows.json request shares:
// the window/top/tailnet/end the aggregates use, plus the seven recent-
// connection filters. cursor is added by the caller (poll vs. load-more want
// a different one), never here.
function baseParams(){
  var p = new URLSearchParams();
  p.set("window", state.window);
  p.set("top", String(state.top));
  if (state.tailnet) p.set("tailnet", state.tailnet);
  if (state.end) p.set("end", state.end);
  var f = state.filters;
  ["device", "addr", "service", "identity", "type", "verdict", "path"].forEach(function(k){
    if (f[k]) p.set(k, f[k]);
  });
  return p;
}

function query(){
  return "/api/flows.json?" + baseParams().toString();
}

function poll(){
  fetch(query(), {headers:{"Accept":"application/json"}, credentials:"same-origin"})
    .then(function(r){
      if (!r.ok) throw new Error("HTTP " + r.status);
      return r.json();
    })
    .then(function(d){
      banner("errBanner", "");
      state.data = d;
      // A fresh top-level poll always restarts recent-connection pagination
      // at page 1 — whatever "load more" had accumulated belonged to the
      // previous poll's page 1, which this response has just replaced.
      state.recentExtra = [];
      render(d);
    })
    .catch(function(e){
      banner("errBanner", "Could not load flow data: " + e.message + ". Retrying.");
    });
}

// loadMore fetches the next page of recent connections using the cursor the
// last response carried, and appends it — a filter matching a connection
// beyond the first page is reached this way, never dropped (#296). It
// updates only the recent-connections section; the aggregates above it stay
// exactly as the last poll left them.
function loadMore(){
  var d = state.data;
  if (!d || !d.next_cursor) return;
  var p = baseParams();
  p.set("cursor", d.next_cursor);
  el("flowLoadMore").disabled = true;
  fetch("/api/flows.json?" + p.toString(), {headers:{"Accept":"application/json"}, credentials:"same-origin"})
    .then(function(r){
      if (!r.ok) throw new Error("HTTP " + r.status);
      return r.json();
    })
    .then(function(more){
      state.recentExtra = state.recentExtra.concat(more.recent || []);
      // The NEXT load-more call must resume where THIS page left off, so the
      // cursor on state.data (what loadMore reads) has to move forward too.
      state.data.next_cursor = more.next_cursor;
      renderFlows(state.data);
    })
    .catch(function(e){
      banner("errBanner", "Could not load more connections: " + e.message + ".");
    })
    .then(function(){ el("flowLoadMore").disabled = false; });
}

function banner(id, msg){
  var b = el(id);
  b.textContent = msg;
  b.classList.toggle("show", !!msg);
}

function schedule(){
  if (state.timer) clearInterval(state.timer);
  // Paused (a span is pinned) means no polling: the answer cannot change.
  if (!state.end) state.timer = setInterval(poll, Math.max(1000, REFRESH_MS));
}

// ------------------------------------------------------------------ rendering

function render(d){
  dropStaleSelection(d);
  renderCards(d);
  renderTimeline(d);
  renderTopology(d);
  renderBars("barsTrafficTypes", d.result.traffic_types);
  renderBars("barsTransports", d.result.transports);
  renderBars("barsOSes", d.result.oses);
  renderBars("barsUsers", d.result.users);
  renderBars("barsTags", d.result.tags);
  renderNodes(d);
  renderPairs(d);
  renderPorts(d);
  renderMatrix(d);
  renderPolicy(d);
  renderPathQuality(d);
  renderFlows(d);

  // Nothing retained yet: say so rather than claiming to cover a zero window.
  var w = d.result.window || {};
  el("covered").textContent = isZeroTime(w.start)
    ? "nothing retained yet"
    : "covering " + fmtClock(w.start) + " → " + fmtClock(w.end);

  var t = d.result.truncated || 0;
  banner("truncBanner", t
    ? "Coverage is partial: " + fmtNum(t) + " observations exceeded a per-minute cap and were folded into “other”. "
      + "Totals remain exact; the ranked lists and the graph do not show every distinct key."
    : "");
}

function renderCards(d){
  var t = d.result.totals || {}, s = d.stats || {};
  var nodes = (d.result.nodes || []).length;
  var cards = [
    {k:"Traffic", v:fmtBytes(bytes(t)),
     sub:"tx " + fmtBytes(t.tx_bytes) + " · rx " + fmtBytes(t.rx_bytes)},
    {k:"Packets", v:fmtNum((t.tx_packets||0) + (t.rx_packets||0)),
     sub:"tx " + fmtNum(t.tx_packets) + " · rx " + fmtNum(t.rx_packets)},
    {k:"Connections", v:fmtNum(t.flows), sub:"in the selected window"},
    {k:"Devices seen", v:String(nodes), sub:"top " + state.top + " shown"},
    {k:"Conversations", v:String((d.result.pairs||[]).length), sub:"directed device pairs"},
    {k:"Retained", v:fmtNum(s.buckets) + " min", sub:"of " + fmtNum(s.capacity) + " · " + fmtNum(s.observations) + " observations"}
  ];
  var c = el("cards");
  clear(c);
  cards.forEach(function(x){
    var div = document.createElement("div");
    div.className = "card";
    var k = document.createElement("div"); k.className = "k"; k.textContent = x.k;
    var v = document.createElement("div"); v.className = "v"; v.textContent = x.v;
    var s2 = document.createElement("div"); s2.className = "sub"; s2.textContent = x.sub;
    div.appendChild(k); div.appendChild(v); div.appendChild(s2);
    c.appendChild(div);
  });
}

// ---------------------------------------------------------------- timeline

var timelineGeom = null; // {x0,x1,t0,t1} for translating a drag back to a time

function renderTimeline(d){
  var svg = el("timeline");
  clear(svg);
  var pts = d.result.series || [];
  var W = svg.clientWidth || 900, H = svg.clientHeight || 150;
  svg.setAttribute("viewBox", "0 0 " + W + " " + H);
  if (!pts.length){
    svg.appendChild(svgEl("text", {x:W/2, y:H/2, "text-anchor":"middle", fill:"var(--muted)",
      "font-size":"12"})).textContent = "no traffic recorded in this window";
    svg.setAttribute("aria-label", "Traffic over time: no traffic recorded in this window.");
    timelineGeom = null;
    return;
  }

  var padL = 4, padR = 4, padT = 8, padB = 16;
  var t0 = new Date(pts[0].time).getTime();
  var t1 = new Date(pts[pts.length-1].time).getTime();
  if (t1 <= t0) t1 = t0 + 60000;
  var maxV = 1, totalTx = 0, totalRx = 0;
  pts.forEach(function(p){
    maxV = Math.max(maxV, p.counts.tx_bytes||0, p.counts.rx_bytes||0);
    totalTx += p.counts.tx_bytes||0; totalRx += p.counts.rx_bytes||0;
  });
  // A textual summary for assistive tech: the only accessible description of
  // what the chart shows, since the SVG's own shapes carry no text.
  svg.setAttribute("aria-label", "Traffic over time from " + fmtTime(pts[0].time) + " to "
    + fmtTime(pts[pts.length-1].time) + ": " + fmtBytes(totalTx) + " transmitted, "
    + fmtBytes(totalRx) + " received, across " + pts.length + " samples.");

  var x0 = padL, x1 = W - padR, y0 = padT, y1 = H - padB;
  timelineGeom = {x0:x0, x1:x1, t0:t0, t1:t1};
  function X(t){ return x0 + (x1-x0) * ((t - t0) / (t1 - t0)); }
  function Y(v){ return y1 - (y1-y0) * (v / maxV); }

  // Horizontal guides, three of them: enough to read a magnitude, few enough to
  // stay out of the way.
  [0.25, 0.5, 0.75].forEach(function(f){
    svg.appendChild(svgEl("line", {x1:x0, x2:x1, y1:Y(maxV*f), y2:Y(maxV*f),
      stroke:"var(--grid)", "stroke-width":"1"}));
  });

  function area(key, colour){
    var dparts = ["M " + X(t0) + " " + y1];
    pts.forEach(function(p){ dparts.push("L " + X(new Date(p.time).getTime()) + " " + Y(p.counts[key]||0)); });
    dparts.push("L " + X(t1) + " " + y1, "Z");
    svg.appendChild(svgEl("path", {d:dparts.join(" "), fill:colour, "fill-opacity":"0.14"}));
    var line = ["M"];
    pts.forEach(function(p, i){
      line.push((i ? "L " : "") + X(new Date(p.time).getTime()) + " " + Y(p.counts[key]||0));
    });
    svg.appendChild(svgEl("path", {d:line.join(" "), fill:"none", stroke:colour, "stroke-width":"1.6"}));
  }
  area("rx_bytes", "var(--rx)");
  area("tx_bytes", "var(--tx)");

  svg.appendChild(svgEl("line", {x1:x0, x2:x1, y1:y1, y2:y1, stroke:"var(--line)", "stroke-width":"1"}));
  var lo = svgEl("text", {x:x0, y:H-4, fill:"var(--muted)", "font-size":"10"});
  lo.textContent = fmtTime(pts[0].time);
  svg.appendChild(lo);
  var hi = svgEl("text", {x:x1, y:H-4, fill:"var(--muted)", "font-size":"10", "text-anchor":"end"});
  hi.textContent = fmtTime(pts[pts.length-1].time);
  svg.appendChild(hi);

  var sel = svgEl("rect", {x:0, y:y0, width:0, height:y1-y0, fill:"var(--accent)",
    "fill-opacity":"0.18", stroke:"var(--accent)", "stroke-width":"1", visibility:"hidden"});
  svg.appendChild(sel);
  wireBrush(svg, sel, pts, y0, y1);
}

// wireBrush turns a horizontal drag on the timeline into a pinned span. The
// selection is expressed as (end, window), which is exactly what the API takes.
function wireBrush(svg, sel, pts, y0, y1){
  var dragging = false, ax = 0;

  function localX(ev){
    var r = svg.getBoundingClientRect();
    var vb = svg.viewBox.baseVal;
    return (ev.clientX - r.left) * (vb.width / r.width);
  }
  function timeAt(x){
    if (!timelineGeom) return null;
    var g = timelineGeom;
    var f = Math.min(1, Math.max(0, (x - g.x0) / (g.x1 - g.x0)));
    return g.t0 + f * (g.t1 - g.t0);
  }

  svg.addEventListener("pointerdown", function(ev){
    if (!timelineGeom) return;
    dragging = true; ax = localX(ev);
    sel.setAttribute("x", ax); sel.setAttribute("width", 0);
    sel.setAttribute("visibility", "visible");
    svg.setPointerCapture(ev.pointerId);
  });
  svg.addEventListener("pointermove", function(ev){
    if (!dragging) return;
    var x = localX(ev);
    sel.setAttribute("x", Math.min(ax, x));
    sel.setAttribute("width", Math.abs(x - ax));
  });
  svg.addEventListener("pointerup", function(ev){
    if (!dragging) return;
    dragging = false;
    sel.setAttribute("visibility", "hidden");
    var bx = localX(ev);
    var lo = timeAt(Math.min(ax, bx)), hi = timeAt(Math.max(ax, bx));
    if (lo === null || hi === null) return;
    var span = Math.round((hi - lo) / 1000);
    // A click, not a drag: ignore rather than pinning a zero-width window.
    if (span < 60) return;
    state.end = new Date(hi).toISOString();
    state.window = span + "s";
    setLive(false);
    syncURL(true);
    poll();
  });
  svg.addEventListener("dblclick", function(){ resetWindow(); });
}

function resetWindow(){
  state.end = null;
  state.window = currentPreset();
  setLive(true);
  syncURL(true);
  poll();
}

function currentPreset(){
  var b = document.querySelector('#winSeg button[aria-pressed="true"]');
  return b ? b.getAttribute("data-win") : "1h";
}

function setLive(live){
  el("liveBtn").setAttribute("aria-pressed", live ? "true" : "false");
  el("liveBtn").textContent = live ? "● live" : "⏸ pinned";
  el("nowBtn").style.display = live ? "none" : "";
  schedule();
}

// ---------------------------------------------------------------- topology

// A small force-directed layout. Repulsion is O(n²), but n is the top-N device
// count (<=200), so a tick is trivial. Positions persist across polls in
// state.positions so a refresh does not reshuffle the picture under the cursor.
var topoSim = null;

function renderTopology(d){
  var svg = el("topo");
  clear(svg);
  var W = svg.clientWidth || 900, H = svg.clientHeight || 460;
  svg.setAttribute("viewBox", "0 0 " + W + " " + H);

  var nodeStats = (d.result.nodes || []).filter(function(n){ return n.node !== OTHER; });
  var known = {};
  nodeStats.forEach(function(n){ known[n.node] = n; });
  var edges = (d.result.pairs || []).filter(function(p){
    return p.src !== OTHER && p.dst !== OTHER && known[p.src] && known[p.dst];
  });

  el("topoHint").textContent = nodeStats.length
    ? nodeStats.length + " devices · " + edges.length + " conversations"
    : "";
  // A textual summary for assistive tech: the only accessible description of
  // what the graph shows, since the SVG's own shapes carry no text.
  svg.setAttribute("aria-label", "Device topology graph: " + (nodeStats.length
    ? nodeStats.length + " devices, " + edges.length + " conversations."
    : "no device-to-device traffic in this window."));

  if (!nodeStats.length){
    var t = svgEl("text", {x:W/2, y:H/2, "text-anchor":"middle", fill:"var(--muted)", "font-size":"13"});
    t.textContent = "no device-to-device traffic in this window";
    svg.appendChild(t);
    topoSim = null;
    return;
  }

  var maxBytes = 1;
  nodeStats.forEach(function(n){ maxBytes = Math.max(maxBytes, bytes(n.sent) + bytes(n.received)); });
  var maxEdge = 1;
  edges.forEach(function(e){ maxEdge = Math.max(maxEdge, bytes(e.counts)); });

  // Seed positions on a circle so the first tick has something to relax, and
  // reuse any position we already had for a device.
  var nodes = nodeStats.map(function(n, i){
    var prev = state.positions[n.node];
    var a = (i / nodeStats.length) * Math.PI * 2;
    return {
      id: n.node,
      stat: n,
      total: bytes(n.sent) + bytes(n.received),
      x: prev ? prev.x : W/2 + Math.cos(a) * Math.min(W, H) * 0.32,
      y: prev ? prev.y : H/2 + Math.sin(a) * Math.min(W, H) * 0.32,
      vx: 0, vy: 0, fixed: false
    };
  });
  var byId = {};
  nodes.forEach(function(n){ byId[n.id] = n; });
  var links = edges.map(function(e){
    return {s: byId[e.src], t: byId[e.dst], w: bytes(e.counts), pair: e};
  });

  var gEdges = svgEl("g", {});
  var gNodes = svgEl("g", {});
  var gLabels = svgEl("g", {});
  svg.appendChild(gEdges); svg.appendChild(gNodes); svg.appendChild(gLabels);

  links.forEach(function(l){
    l.el = svgEl("line", {class:"edge",
      "stroke-width": (1 + 4 * Math.sqrt(l.w / maxEdge)).toFixed(2)});
    l.el.addEventListener("mouseenter", function(ev){
      showTip(ev, l.pair.src + " → " + l.pair.dst + "\n" + l.pair.traffic_type + "\n"
        + fmtBytes(bytes(l.pair.counts)) + "  (" + fmtNum(l.pair.counts.flows) + " conns)");
    });
    l.el.addEventListener("mouseleave", hideTip);
    gEdges.appendChild(l.el);
  });

  nodes.forEach(function(n){
    n.r = 4 + 12 * Math.sqrt(n.total / maxBytes);
    n.el = svgEl("circle", {class:"node", r:n.r.toFixed(1)});
    // "external" and "unknown" are collapsed buckets from the enrichment layer,
    // not devices; colouring them apart stops them reading as one busy machine.
    if (n.id === "external" || n.id === "unknown") n.el.setAttribute("class", "node ext");
    n.lbl = svgEl("text", {class:"lbl", "text-anchor":"middle"});
    n.lbl.textContent = n.id.length > 22 ? n.id.slice(0, 21) + "…" : n.id;
    n.el.addEventListener("mouseenter", function(ev){
      showTip(ev, n.id + "\nsent " + fmtBytes(bytes(n.stat.sent))
        + "\nreceived " + fmtBytes(bytes(n.stat.received)));
    });
    n.el.addEventListener("mouseleave", hideTip);
    n.el.addEventListener("click", function(ev){
      ev.stopPropagation();
      select(state.selected === n.id ? null : n.id);
    });
    // Keyboard equivalent of the click-to-filter above: each device is a
    // graph node with no other way to reach it, so it needs its own stop in
    // the Tab order (SVG shapes are not natively focusable), a name to
    // announce, and an Enter/Space activation matching the click handler.
    n.el.setAttribute("tabindex", "0");
    n.el.setAttribute("role", "button");
    n.el.setAttribute("aria-label", n.id + ", sent " + fmtBytes(bytes(n.stat.sent)) + ", received " + fmtBytes(bytes(n.stat.received)));
    n.el.addEventListener("keydown", function(ev){
      if (ev.key === "Enter" || ev.key === " "){
        ev.preventDefault(); ev.stopPropagation();
        select(state.selected === n.id ? null : n.id);
      }
    });
    attachDrag(svg, n);
    gNodes.appendChild(n.el);
    gLabels.appendChild(n.lbl);
  });

  svg.addEventListener("click", function(){ select(null); });

  topoSim = {svg:svg, W:W, H:H, nodes:nodes, links:links, alpha:1};
  runSim();
  applySelection();
}

function attachDrag(svg, n){
  var moved = false;
  n.el.addEventListener("pointerdown", function(ev){
    ev.stopPropagation();
    moved = false;
    n.fixed = true;
    svg.classList.add("drag");
    n.el.setPointerCapture(ev.pointerId);
    function move(e2){
      moved = true;
      var r = svg.getBoundingClientRect();
      var vb = svg.viewBox.baseVal;
      n.x = (e2.clientX - r.left) * (vb.width / r.width);
      n.y = (e2.clientY - r.top) * (vb.height / r.height);
      n.vx = n.vy = 0;
      if (topoSim) { topoSim.alpha = Math.max(topoSim.alpha, 0.3); runSim(); }
    }
    function up(e2){
      n.el.releasePointerCapture(e2.pointerId);
      svg.classList.remove("drag");
      n.el.removeEventListener("pointermove", move);
      n.el.removeEventListener("pointerup", up);
      // A drag that never moved is a click; leave the node free again.
      if (!moved) n.fixed = false;
    }
    n.el.addEventListener("pointermove", move);
    n.el.addEventListener("pointerup", up);
  });
}

var simRAF = null;
function prefersReducedMotion(){
  return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
}

function runSim(){
  if (simRAF) return;
  if (!topoSim) return;
  // The force-directed relaxation is the one genuinely animated element on
  // either embedded page: normally it eases into place across ~30
  // requestAnimationFrame steps. With reduced motion requested, settle it in
  // one synchronous pass and paint the final layout directly instead.
  if (prefersReducedMotion()){
    while (topoSim.alpha > 0.02){ tick(topoSim); topoSim.alpha *= 0.97; }
    paint(topoSim);
    rememberPositions();
    return;
  }
  function step(){
    simRAF = null;
    if (!topoSim) return;
    for (var i = 0; i < 3; i++) tick(topoSim);
    paint(topoSim);
    topoSim.alpha *= 0.97;
    if (topoSim.alpha > 0.02) simRAF = requestAnimationFrame(step);
    else rememberPositions();
  }
  simRAF = requestAnimationFrame(step);
}

function tick(sim){
  var n = sim.nodes, cx = sim.W/2, cy = sim.H/2, k = sim.alpha;
  // Repulsion.
  for (var i = 0; i < n.length; i++){
    for (var j = i+1; j < n.length; j++){
      var a = n[i], b = n[j];
      var dx = b.x - a.x, dy = b.y - a.y;
      var d2 = dx*dx + dy*dy;
      if (d2 < 0.01){ dx = (Math.random()-0.5); dy = (Math.random()-0.5); d2 = 0.01; }
      var d = Math.sqrt(d2);
      var minSep = a.r + b.r + 14;
      var f = (2600 + (d < minSep ? 9000 : 0)) / d2;
      var fx = (dx/d) * f * k, fy = (dy/d) * f * k;
      a.vx -= fx; a.vy -= fy; b.vx += fx; b.vy += fy;
    }
  }
  // Springs. A heavier conversation pulls its endpoints closer together.
  sim.links.forEach(function(l){
    var dx = l.t.x - l.s.x, dy = l.t.y - l.s.y;
    var d = Math.sqrt(dx*dx + dy*dy) || 0.01;
    var rest = 120;
    var f = (d - rest) * 0.012 * k;
    var fx = (dx/d) * f, fy = (dy/d) * f;
    l.s.vx += fx; l.s.vy += fy; l.t.vx -= fx; l.t.vy -= fy;
  });
  // Centering + integrate.
  n.forEach(function(p){
    p.vx += (cx - p.x) * 0.004 * k;
    p.vy += (cy - p.y) * 0.004 * k;
    if (p.fixed){ p.vx = p.vy = 0; return; }
    p.vx *= 0.82; p.vy *= 0.82;
    p.x += p.vx; p.y += p.vy;
    var m = p.r + 6;
    p.x = Math.min(sim.W - m, Math.max(m, p.x));
    p.y = Math.min(sim.H - m, Math.max(m, p.y));
  });
}

function paint(sim){
  sim.links.forEach(function(l){
    l.el.setAttribute("x1", l.s.x.toFixed(1)); l.el.setAttribute("y1", l.s.y.toFixed(1));
    l.el.setAttribute("x2", l.t.x.toFixed(1)); l.el.setAttribute("y2", l.t.y.toFixed(1));
  });
  sim.nodes.forEach(function(p){
    p.el.setAttribute("cx", p.x.toFixed(1)); p.el.setAttribute("cy", p.y.toFixed(1));
    p.lbl.setAttribute("x", p.x.toFixed(1));
    p.lbl.setAttribute("y", (p.y + p.r + 11).toFixed(1));
  });
}

function rememberPositions(){
  if (!topoSim) return;
  topoSim.nodes.forEach(function(p){ state.positions[p.id] = {x:p.x, y:p.y}; });
}

// select filters the whole page to one device: the graph dims everything not
// adjacent to it, and the tables drop rows it is not part of.
function select(name){
  state.selected = name;
  syncURL(true);
  applySelection();
  if (state.data) {
    renderNodes(state.data);
    renderPairs(state.data);
    renderFlows(state.data);
  }
}

function applySelection(){
  var sel = state.selected;
  if (!topoSim) return;
  var adjacent = {};
  if (sel){
    adjacent[sel] = true;
    topoSim.links.forEach(function(l){
      if (l.s.id === sel) adjacent[l.t.id] = true;
      if (l.t.id === sel) adjacent[l.s.id] = true;
    });
  }
  topoSim.nodes.forEach(function(p){
    var base = (p.id === "external" || p.id === "unknown") ? "node ext" : "node";
    p.el.setAttribute("aria-pressed", p.id === sel ? "true" : "false");
    if (!sel) { p.el.setAttribute("class", base); p.lbl.setAttribute("class", "lbl"); return; }
    p.el.setAttribute("class", base + (p.id === sel ? " sel" : (adjacent[p.id] ? "" : " dim")));
    p.lbl.setAttribute("class", "lbl" + (adjacent[p.id] ? "" : " dim"));
  });
  topoSim.links.forEach(function(l){
    if (!sel) { l.el.setAttribute("class", "edge"); return; }
    var touches = l.s.id === sel || l.t.id === sel;
    l.el.setAttribute("class", "edge" + (touches ? " hi" : " dim"));
  });
}

// -------------------------------------------------------------------- tips

function showTip(ev, text){
  var t = el("tip");
  t.textContent = text;
  t.style.display = "block";
  t.style.left = Math.min(window.innerWidth - t.offsetWidth - 10, ev.clientX + 12) + "px";
  t.style.top  = Math.min(window.innerHeight - t.offsetHeight - 10, ev.clientY + 12) + "px";
}
function hideTip(){ el("tip").style.display = "none"; }

// ------------------------------------------------------------------- bars

function renderBars(id, rows){
  var host = el(id);
  clear(host);
  rows = (rows || []).slice(0, 10);
  if (!rows.length){
    var e = document.createElement("div");
    e.className = "empty";
    e.textContent = "not carried in this window";
    host.appendChild(e);
    return;
  }
  var maxV = 1;
  rows.forEach(function(r){ maxV = Math.max(maxV, bytes(r.counts)); });
  rows.forEach(function(r){
    var row = document.createElement("div");
    row.className = "bar";
    var n = document.createElement("div"); n.className = "bn";
    n.textContent = label(r.label); n.title = label(r.label);
    var t = document.createElement("div"); t.className = "bt";
    var f = document.createElement("div"); f.className = "bf";
    f.style.width = Math.max(2, 100 * bytes(r.counts) / maxV) + "%";
    t.appendChild(f);
    var v = document.createElement("div"); v.className = "bv";
    v.textContent = fmtBytes(bytes(r.counts));
    row.appendChild(n); row.appendChild(t); row.appendChild(v);
    host.appendChild(row);
  });
}

// ------------------------------------------------------------------ tables

function buildTable(host, headers, rows, emptyMsg){
  clear(host);
  if (!rows.length){
    var e = document.createElement("div");
    e.className = "empty panel";
    e.textContent = emptyMsg;
    host.appendChild(e);
    return;
  }
  var tbl = document.createElement("table");
  var thead = document.createElement("thead");
  var htr = document.createElement("tr");
  headers.forEach(function(h){
    var th = document.createElement("th");
    th.textContent = h.text;
    if (h.num) th.style.textAlign = "right";
    htr.appendChild(th);
  });
  thead.appendChild(htr);
  tbl.appendChild(thead);
  var tbody = document.createElement("tbody");
  rows.forEach(function(r){
    var tr = document.createElement("tr");
    if (r.pick){
      tr.className = "pick" + (r.selected ? " sel" : "");
      // A pickable row acts like a toggle button with no other way to reach
      // it, so it needs its own stop in the Tab order, a name to announce
      // (a bare "button" reading out every cell is not that), a pressed
      // state, and an Enter/Space activation matching the click handler.
      tr.tabIndex = 0;
      tr.setAttribute("role", "button");
      tr.setAttribute("aria-pressed", r.selected ? "true" : "false");
      if (r.label) tr.setAttribute("aria-label", r.label);
      tr.addEventListener("click", r.pick);
      tr.addEventListener("keydown", function(ev){
        if (ev.key === "Enter" || ev.key === " "){ ev.preventDefault(); r.pick(); }
      });
    }
    r.cells.forEach(function(c){
      var td = document.createElement("td");
      if (c.cls) td.className = c.cls;
      if (c.node) td.appendChild(c.node); else td.textContent = c.text;
      tr.appendChild(td);
    });
    tbody.appendChild(tr);
  });
  tbl.appendChild(tbody);
  host.appendChild(tbl);
}

function renderNodes(d){
  var rows = (d.result.nodes || []).filter(function(n){
    return !state.selected || n.node === state.selected;
  }).map(function(n){
    return {
      pick: function(){ select(state.selected === n.node ? null : n.node); },
      selected: state.selected === n.node,
      label: "Filter the page to device " + n.node,
      cells: [
        {text: label(n.node), cls:"mono"},
        {text: fmtBytes(bytes(n.sent)), cls:"num"},
        {text: fmtBytes(bytes(n.received)), cls:"num"},
        {text: fmtNum((n.sent.flows||0) + (n.received.flows||0)), cls:"num"}
      ]
    };
  });
  buildTable(el("tblNodes"), [
    {text:"Device"}, {text:"Sent", num:true}, {text:"Received", num:true}, {text:"Conns", num:true}
  ], rows, "no device traffic in this window");
}

function renderPairs(d){
  var rows = (d.result.pairs || []).filter(function(p){
    return !state.selected || p.src === state.selected || p.dst === state.selected;
  }).map(function(p){
    var pill = document.createElement("span");
    pill.className = "pill " + p.traffic_type;
    pill.textContent = p.traffic_type;
    return {
      cells: [
        {text: label(p.src), cls:"mono"},
        {text: label(p.dst), cls:"mono"},
        {node: pill},
        {text: fmtBytes(bytes(p.counts)), cls:"num"},
        {text: fmtNum(p.counts.flows), cls:"num"}
      ]
    };
  });
  buildTable(el("tblPairs"), [
    {text:"Source"}, {text:"Destination"}, {text:"Type"}, {text:"Bytes", num:true}, {text:"Conns", num:true}
  ], rows, "no conversations in this window");
}

function renderPorts(d){
  var rows = (d.result.ports || []).map(function(p){
    return {
      cells: [
        {text: (p.service ? p.service : label(p.port)), cls:"mono"},
        {text: p.port === OTHER ? "—" : p.port + "/" + p.transport, cls:"mono"},
        {text: fmtBytes(bytes(p.counts)), cls:"num"}
      ]
    };
  });
  buildTable(el("tblPorts"), [
    {text:"Service"}, {text:"Port"}, {text:"Bytes", num:true}
  ], rows, "no destination ports in this window");
}

// ---------------------------------------------------------------- matrix

// Axis length is a readability bound, not a data bound: a grid wider than this
// cannot be read, and the server has already ranked the cells by volume. What is
// left out is stated rather than silently dropped.
var MATRIX_AXIS = 14;

// A cell needs the identity on BOTH endpoints. On live data tags carry on both
// ends of ~70% of node pairings and users on ~1% (a tagged machine has no user),
// which is why the tag matrix leads and the user one is offered rather than
// promoted. There is no OS matrix: the API supplies `os` on destinations only.
var MATRIX_KINDS = {
  tag: {
    field:"tag_matrix", noun:"tags",
    // Why traffic falls outside the grid differs per kind, and getting it the
    // wrong way round would send an operator looking in the wrong place.
    rest:"exit traffic, and devices owned by a person rather than a tag",
    blank:"no flow in this window had tags on both endpoints"
  },
  user: {
    field:"user_matrix", noun:"users",
    rest:"tag-owned devices, which have no user at all, and exit traffic",
    blank:"no flow in this window had a user on both endpoints — tag-owned devices carry no user, so a machine-to-machine tailnet shows nothing here"
  }
};

function renderMatrix(d){
  var kind = MATRIX_KINDS[state.matrixKind];
  var host = el("matrix");
  clear(host);
  var all = d.result[kind.field] || [];

  // Rank the axes by their own totals so the busiest identities sit top-left.
  var srcTot = {}, dstTot = {}, byKey = {}, shown = 0;
  all.forEach(function(c){
    srcTot[c.src] = (srcTot[c.src] || 0) + bytes(c.counts);
    dstTot[c.dst] = (dstTot[c.dst] || 0) + bytes(c.counts);
    byKey[c.src + "␀" + c.dst] = c;
    shown += bytes(c.counts);
  });
  var rows = Object.keys(srcTot).sort(function(a, b){ return srcTot[b] - srcTot[a] || (a < b ? -1 : 1); });
  var cols = Object.keys(dstTot).sort(function(a, b){ return dstTot[b] - dstTot[a] || (a < b ? -1 : 1); });
  var moreRows = Math.max(0, rows.length - MATRIX_AXIS);
  var moreCols = Math.max(0, cols.length - MATRIX_AXIS);
  rows = rows.slice(0, MATRIX_AXIS);
  cols = cols.slice(0, MATRIX_AXIS);

  renderCoverage(d, shown, kind, moreRows, moreCols);

  if (!rows.length){
    var e = document.createElement("div");
    e.className = "empty";
    e.textContent = kind.blank;
    host.appendChild(e);
    return;
  }

  var maxV = 1;
  rows.forEach(function(r){
    cols.forEach(function(c){
      var cell = byKey[r + "␀" + c];
      if (cell) maxV = Math.max(maxV, bytes(cell.counts));
    });
  });

  var tbl = document.createElement("table");
  var thead = document.createElement("thead");
  var htr = document.createElement("tr");
  var corner = document.createElement("th");
  corner.className = "corner";
  corner.textContent = "from ↓ / to →";
  htr.appendChild(corner);
  cols.forEach(function(c){
    var th = document.createElement("th");
    th.className = "colh";
    th.textContent = label(c);
    th.title = label(c);
    htr.appendChild(th);
  });
  thead.appendChild(htr);
  tbl.appendChild(thead);

  var tbody = document.createElement("tbody");
  rows.forEach(function(r){
    var tr = document.createElement("tr");
    var rh = document.createElement("th");
    rh.className = "rowh";
    rh.textContent = label(r);
    rh.title = label(r);
    tr.appendChild(rh);
    cols.forEach(function(c){
      var td = document.createElement("td");
      var cell = byKey[r + "␀" + c];
      var v = cell ? bytes(cell.counts) : 0;
      var div = document.createElement("div");
      var picked = state.cell && state.cell.src === r && state.cell.dst === c;
      div.className = "cell" + (v ? "" : " zero") + (picked ? " sel" : "");
      if (v){
        // Square-root scaling: a linear ramp makes everything but the single
        // busiest cell look empty on real traffic, which is heavily skewed.
        var f = Math.sqrt(v / maxV);
        div.style.background = "color-mix(in srgb, var(--accent) " + Math.round(12 + 88 * f) + "%, var(--panel2))";
        if (f > 0.55) div.classList.add("hot");
        div.textContent = fmtShort(v);
        div.title = label(r) + " → " + label(c) + "\n" + fmtBytes(v)
          + "  (" + fmtNum(cell.counts.flows) + " conns)";
        // A cell acts like a toggle button reachable only here, so it needs
        // its own stop in the Tab order, a name (the div's visible text is
        // just a byte count, not the connection it represents), a pressed
        // state, and an Enter/Space activation matching the click handler.
        div.tabIndex = 0;
        div.setAttribute("role", "button");
        div.setAttribute("aria-label", label(r) + " to " + label(c) + ", " + fmtBytes(v)
          + ", " + fmtNum(cell.counts.flows) + " connections");
        div.setAttribute("aria-pressed", picked ? "true" : "false");
        div.addEventListener("click", function(){ pickCell(r, c); });
        div.addEventListener("keydown", function(ev){
          if (ev.key === "Enter" || ev.key === " "){ ev.preventDefault(); pickCell(r, c); }
        });
      } else {
        div.textContent = "·";
      }
      td.appendChild(div);
      tr.appendChild(td);
    });
    tbody.appendChild(tr);
  });
  tbl.appendChild(tbody);
  host.appendChild(tbl);
}

// renderCoverage states what share of the window's traffic the matrix accounts
// for. A flow with no identity on both endpoints occupies no cell, so without
// this the grid would quietly imply it describes everything.
function renderCoverage(d, shown, kind, moreRows, moreCols){
  var total = bytes(d.result.totals);
  var parts = [];
  if (total > 0){
    var pct = Math.round(100 * shown / total);
    parts.push("Covers <b>" + pct + "%</b> of traffic in this window ("
      + fmtBytes(shown) + " of " + fmtBytes(total) + "). The remainder involves at least one endpoint "
      + "carrying no " + kind.noun + ": " + kind.rest + ".");
  }
  if (moreRows || moreCols){
    parts.push("Showing the busiest " + MATRIX_AXIS + " of each axis; "
      + (moreRows ? moreRows + " more sources" : "")
      + (moreRows && moreCols ? " and " : "")
      + (moreCols ? moreCols + " more destinations" : "") + " are not drawn.");
  }
  el("matrixCoverage").innerHTML = parts.join(" ");
}

function pickCell(src, dst){
  var same = state.cell && state.cell.src === src && state.cell.dst === dst;
  state.cell = same ? null : {src: src, dst: dst};
  el("matrixClear").style.display = state.cell ? "" : "none";
  syncURL(true);
  if (state.data){ renderMatrix(state.data); renderFlows(state.data); }
}

// matchesCell tests one retained connection against the selected matrix cell,
// using the same kind the grid is showing.
function matchesCell(f){
  if (!state.cell) return true;
  var s = state.cell.src, d = state.cell.dst;
  switch (state.matrixKind){
    case "tag":  return hasTag(f.src_tags, s) && hasTag(f.dst_tags, d);
    case "user": return f.src_user === s && f.dst_user === d;
    case "os":   return f.src_os === s && f.dst_os === d;
  }
  return true;
}

// identityOf renders the identity a connection carried, for the second line of
// an endpoint cell. Absent fields are simply not mentioned.
// endpointCell renders one side of a connection: the device and address on the
// first line, whatever identity the record carried on a second, muted one. An
// absent endpoint is an em dash — exit traffic genuinely has no destination, and
// showing a made-up one would be worse than showing nothing.
// ------------------------------------------------------- policy reconciliation

// The four states a connection can be in, in the order they are stacked. Return
// traffic is deliberately its own band and NOT an alarm colour: flow logs report
// both halves of a connection while a policy governs only the half it was
// established in, so on real traffic this band is large (37% of connections on a
// live capture) and entirely normal.
//
// "undetermined" is likewise not a finding. It means the policy could not be
// applied, and presenting it as anything else is what would turn this section
// from a diagnostic into a generator of confident false alarms.
var VERDICTS = [
  {key:"permitted", text:"permitted", colour:"var(--ok)",
   note:"A rule covers this in the direction it was observed."},
  {key:"permitted_reverse", text:"return traffic", colour:"var(--accent)",
   note:"The half of the connection that established it is covered by a rule. Flow logs report both halves; a policy governs only one. This is normal."},
  {key:"no_rule", text:"not explained", colour:"var(--warn)",
   note:"No rule covers this in either direction, as this evaluator reads the policy."},
  {key:"undetermined", text:"undecidable", colour:"var(--muted)",
   note:"The policy could not be applied here — an undeclared group, a VIP service, or an endpoint carrying no identity. Never a finding."}
];

function verdictText(v, reversed){
  if (!v) return "";
  var key = (v === "permitted" && reversed) ? "permitted_reverse" : v;
  for (var i = 0; i < VERDICTS.length; i++){
    if (VERDICTS[i].key === key) return VERDICTS[i].text;
  }
  return key;
}

function verdictKey(v, reversed){
  return (v === "permitted" && reversed) ? "permitted_reverse" : (v || "");
}

function renderPolicy(d){
  var pol = d.policy || {};
  var counts = {}, evaluated = 0;
  (d.result.verdicts || []).forEach(function(v){
    counts[v.label] = (v.counts && v.counts.flows) || 0;
    evaluated += counts[v.label];
  });

  renderVerdictStrip(counts, evaluated);
  renderPolicyNote(pol, evaluated);
  renderUnexplained(d);
  renderUnexercised(d, pol);
}

function renderVerdictStrip(counts, evaluated){
  var strip = el("policyStrip"), legend = el("policyLegend");
  clear(strip); clear(legend);
  if (!evaluated) return;

  VERDICTS.forEach(function(v){
    var n = counts[v.key] || 0;
    if (n){
      var seg = document.createElement("div");
      seg.style.background = v.colour;
      seg.style.width = (100 * n / evaluated) + "%";
      seg.title = v.text + ": " + fmtNum(n) + " connections";
      strip.appendChild(seg);
    }
    var item = document.createElement("span");
    item.title = v.note;
    var sw = document.createElement("span");
    sw.className = "sw";
    sw.style.background = v.colour;
    var b = document.createElement("b");
    b.textContent = fmtNum(n);
    item.appendChild(sw);
    item.appendChild(b);
    item.appendChild(document.createTextNode(" " + v.text
      + " (" + Math.round(100 * n / evaluated) + "%)"));
    legend.appendChild(item);
  });
}

// renderPolicyNote is the section's honesty statement. Which one applies matters:
// "no policy collected" and "the policy explained everything" look identical
// from the outside, and reporting the first as the second is a clean bill of
// health for a check that never ran.
function renderPolicyNote(pol, evaluated){
  var note = el("policyNote"), parts = [];
  if (pol.error){
    parts.push("The collected policy could not be compiled: <b>" + esc(pol.error) + "</b>."
      + (pol.available ? " Reconciliation is still running against the last policy that did compile."
                       : " Nothing below has been reconciled."));
  }
  if (!pol.available){
    if (!pol.error){
      parts.push("<b>No policy has been collected yet</b>, so nothing here has been checked against one. "
        + "The ACL arrives from the <code>acl</code> collector; if it is disabled, this section stays empty.");
    }
  } else if (!evaluated){
    parts.push("<b>No policy-governed traffic in this window.</b> Physical (underlay) traffic is not "
      + "reconciled — it is the encrypted transport between endpoints, not a connection a policy describes.");
  } else {
    parts.push("Every policy-governed connection in this window was checked against the tailnet&rsquo;s "
      + pol.rules.length + " rules. <b>This is a diagnostic, not an audit.</b> Tailscale itself carried "
      + "all of this traffic, so anything reported below is a lead to look into — most often a subnet "
      + "router or a VIP service whose semantics this reading does not fully capture — rather than "
      + "something that got through.");
  }
  note.innerHTML = parts.join(" ");
}

function renderUnexplained(d){
  var rows = (d.result.unexplained || []).map(function(u){
    return {
      cells: [
        {text: label(u.src), cls:"mono"},
        {text: label(u.dst), cls:"mono"},
        {text: u.port ? u.transport + "/" + u.port : u.transport, cls:"mono"},
        {text: fmtBytes(bytes(u.counts)), cls:"num"},
        {text: fmtNum(u.counts.flows), cls:"num"}
      ]
    };
  });
  var pol = d.policy || {};
  el("unexplainedCount").textContent = rows.length
    ? rows.length + (rows.length === 1 ? " relationship" : " relationships")
    : "";
  buildTable(el("tblUnexplained"), [
    {text:"Source"}, {text:"Destination"}, {text:"Over"},
    {text:"Bytes", num:true}, {text:"Conns", num:true}
  ], rows, pol.available
    ? "every policy-governed connection in this window matched a rule"
    : "no policy collected — nothing has been checked");

  el("unexplainedNote").innerHTML = rows.length
    ? "These relationships matched no rule in either direction. Endpoints are named by their "
      + "tags, then their owner, then their device name, then their address — the order a rule "
      + "would be written in. Aggregating by relationship is what makes this legible: on a live "
      + "tailnet, thousands of individually unexplained connections were three relationships."
    : "";
}

function renderUnexercised(d, pol){
  var exercised = {};
  (d.result.rules || []).forEach(function(r){ exercised[r.rule] = r.counts; });
  var idle = (pol.rules || []).filter(function(r){ return !exercised[r.index]; });

  var win = d.result.window || {};
  var span = isZeroTime(win.start) ? state.window : humanSpan(win.start, win.end);
  el("unexercisedWindow").textContent = pol.available
    ? idle.length + " of " + pol.rules.length + " over " + span
    : "";

  buildTable(el("tblUnexercised"), [
    {text:"#"}, {text:"Kind"}, {text:"Rule"}
  ], idle.map(function(r){
    return {cells: [
      {text: String(r.index), cls:"num"},
      {text: r.kind, cls:"mono"},
      {text: r.source, cls:"rulesrc"}
    ]};
  }), pol.available
    ? "every rule permitted something in this window"
    : "no policy collected — nothing has been checked");

  el("unexercisedNote").innerHTML = idle.length
    ? "<b>Idle is not dead.</b> These rules permitted nothing in the <b>" + esc(span) + "</b> shown — "
      + "NTP, ICMP and break-glass access legitimately go hours without firing. Widen the window "
      + "before concluding a rule is unused."
    : "";
}

// ------------------------------------------------------- path quality
//
// How two nodes actually reached each other, read off the underlay endpoint of
// each physical connection. This is the one thing here a dedicated flow
// visualiser cannot show, because it needs the marker to be recognised for what
// it is rather than treated as an ordinary destination.
//
// Everything in this section counts CONNECTIONS. Relayed connections and relayed
// bytes are wildly different figures on real data — 11.6% of connections but
// 0.4% of bytes on a live tailnet — because DERP carries the handshakes and
// keepalives while bulk transfer goes direct. The per-peer table shows both so
// neither number can be mistaken for the other.
var PATHS = [
  {key:"direct_ipv4", text:"direct IPv4", colour:"var(--ok)",
   note:"The two nodes reached each other directly over IPv4."},
  {key:"direct_ipv6", text:"direct IPv6", colour:"var(--accent)",
   note:"The two nodes reached each other directly over IPv6."},
  {key:"derp", text:"relayed", colour:"var(--warn)",
   note:"The connection went through a DERP relay. Slower and Tailscale-hosted, but still end-to-end encrypted."}
];

function pathText(p){
  for (var i = 0; i < PATHS.length; i++){
    if (PATHS[i].key === p) return PATHS[i].text;
  }
  return p || "";
}

function renderPathQuality(d){
  var counts = {}, total = 0;
  (d.result.paths || []).forEach(function(p){
    counts[p.label] = (p.counts && p.counts.flows) || 0;
    total += counts[p.label];
  });

  renderPathStrip(counts, total);
  renderDERPRegions(d, counts.derp || 0);
  renderPeerPaths(d, total);
}

function renderPathStrip(counts, total){
  var strip = el("pathStrip"), legend = el("pathLegend");
  clear(strip); clear(legend);
  if (!total) return;

  PATHS.forEach(function(p){
    var n = counts[p.key] || 0;
    if (n){
      var seg = document.createElement("div");
      seg.style.background = p.colour;
      seg.style.width = (100 * n / total) + "%";
      seg.title = p.text + ": " + fmtNum(n) + " connections";
      strip.appendChild(seg);
    }
    var item = document.createElement("span");
    item.title = p.note;
    var sw = document.createElement("span");
    sw.className = "sw";
    sw.style.background = p.colour;
    var b = document.createElement("b");
    b.textContent = fmtNum(n);
    item.appendChild(sw);
    item.appendChild(b);
    item.appendChild(document.createTextNode(" " + p.text
      + " (" + Math.round(100 * n / total) + "%)"));
    legend.appendChild(item);
  });
}

// renderDERPRegions lists the relays that carried the relayed share, by ID.
// Tailscale's API does not serve its DERP map, so the ID is genuinely all that
// is knowable here — a built-in name table would go stale silently and mislabel
// a region an operator was about to act on.
function renderDERPRegions(d, relayed){
  var host = el("derpRegions");
  clear(host);
  if (!relayed) return;

  (d.result.derp_regions || []).forEach(function(r){
    var item = document.createElement("span");
    item.title = "DERP region " + r.label + " carried " + fmtNum(r.counts.flows)
      + " relayed connections (" + fmtBytes(bytes(r.counts)) + ")";
    var b = document.createElement("b");
    b.textContent = fmtNum(r.counts.flows);
    item.appendChild(b);
    item.appendChild(document.createTextNode(" via region " + label(r.label)));
    host.appendChild(item);
  });
}

function renderPeerPaths(d, total){
  var peers = d.result.peer_paths || [];
  var relayedPeers = peers.filter(function(p){ return p.relayed.flows > 0; });

  el("peerPathCount").textContent = total
    ? relayedPeers.length + " of " + peers.length + (peers.length === 1 ? " peer" : " peers")
    : "";

  // Two of these columns count connections and one counts bytes, and they are
  // routinely an order of magnitude apart — so each header says which.
  buildTable(el("tblPeerPaths"), [
    {text:"Peer"}, {text:"Relayed conns", num:true}, {text:"Direct conns", num:true},
    {text:"Relayed bytes", num:true}, {text:"Relayed share", num:true}
  ], relayedPeers.map(function(p){
    var conns = p.relayed.flows + p.direct.flows;
    return {cells: [
      {text: label(p.peer), cls:"mono"},
      {text: fmtNum(p.relayed.flows), cls:"num"},
      {text: fmtNum(p.direct.flows), cls:"num"},
      {text: fmtBytes(bytes(p.relayed)), cls:"num"},
      {text: conns ? Math.round(100 * p.relayed.flows / conns) + "%" : "—", cls:"num"}
    ]};
  }), total
    ? "every peer was reached directly in this window"
    : "no underlay traffic in this window");

  el("pathNote").innerHTML = total
    ? "Read off each physical connection&rsquo;s underlay endpoint: Tailscale writes a loopback "
      + "marker in place of an address when a peer had to be relayed, and the DERP region&rsquo;s ID "
      + "in place of the port. The API <b>does not expose</b> the mapping from that ID to a region "
      + "name, so the ID is what is shown."
    : "<b>No underlay traffic in this window.</b> Path quality is read from <code>physicalTraffic</code>, "
      + "which describes the encrypted transport between endpoints rather than the tailnet "
      + "connections carried over it.";

  el("peerPathNote").innerHTML = relayedPeers.length
    ? "<b>Relaying is not a failure.</b> A relayed peer is connected and encrypted end to end; it is "
      + "simply going the long way, so it will show higher latency and lower throughput. The usual "
      + "causes are a hard NAT, blocked UDP, or no route between the two networks. The counts here "
      + "are <b>connections</b> — relayed bytes are usually a far smaller share, because handshakes "
      + "and keepalives relay while bulk transfer finds a direct path."
    : "";
}

// humanSpan describes the covered window in the terms an operator asked for,
// which is what makes the unexercised list interpretable at all.
function humanSpan(startISO, endISO){
  var mins = Math.round((new Date(endISO) - new Date(startISO)) / 60000);
  if (!isFinite(mins) || mins <= 0) return state.window;
  if (mins < 90) return mins + " min";
  var hrs = mins / 60;
  return (hrs < 10 ? hrs.toFixed(1) : String(Math.round(hrs))) + "h";
}

// esc makes a value safe for the few places this page builds markup as a string
// rather than as nodes. Everything it guards is server-side data, but a policy
// document and a compile error are both operator-authored text.
function esc(s){
  return String(s).replace(/[&<>"']/g, function(c){
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
  });
}

function endpointCell(node, addr, user, tags, os){
  var wrap = document.createElement("span");
  wrap.appendChild(document.createTextNode((node || "—") + (addr ? "  " + addr : "")));
  var ident = identityOf(user, tags, os);
  if (ident){
    var s = document.createElement("span");
    s.className = "ident";
    s.textContent = ident;
    wrap.appendChild(s);
  }
  return wrap;
}

function reporterCell(f){
  var wrap = document.createElement("span");
  wrap.appendChild(document.createTextNode(f.reporter_node_id || "—"));
  var diagnosis = [f.reporter_trust, f.reporter_consistency].filter(Boolean).join(" · ");
  if (diagnosis){
    var s = document.createElement("span");
    s.className = "ident";
    s.textContent = diagnosis;
    wrap.appendChild(s);
  }
  return wrap;
}

function identityOf(user, tags, os){
  var bits = [];
  if (user) bits.push(user);
  if (tags) bits.push(tags);
  if (os) bits.push(os);
  return bits.join(" · ");
}

// renderFlows draws the recent-connections table. The seven filter fields
// and the load-more cursor are already applied SERVER-side (#296) — the
// server walks the full retained ring, not just whatever page happens to be
// on screen, so a match beyond the visible rows is one "load more" click
// away rather than invisible. state.selected (a topology click) and
// state.cell (a matrix-cell click) remain a client-side narrowing ON TOP of
// that server-filtered set, so clicking a device or cell in the graphs above
// doesn't cost a re-fetch.
function renderFlows(d){
  var all = (d.recent || []).concat(state.recentExtra || []);
  var rows = all.filter(function(f){
    if (state.selected && f.src_node !== state.selected && f.dst_node !== state.selected) return false;
    if (!matchesCell(f)) return false;
    return true;
  });

  var narrowed = state.selected || state.cell;
  var matched = d.recent_matched || 0, retained = d.recent_retained || 0;
  el("flowCount").textContent = narrowed
    ? rows.length + " of " + all.length + " shown"
    : all.length + (matched > all.length ? " of " + matched + " matched" : " shown");

  var noteParts = [];
  if (matched > all.length) noteParts.push((matched - all.length) + " more match the current filters — use load more.");
  if (d.recent_truncated) {
    noteParts.push("The connection ring holds only the newest " + fmtNum(retained) +
      "; older matching connections may already have been evicted rather than simply not existing.");
  }
  el("flowPageNote").textContent = noteParts.join(" ");

  var more = el("flowLoadMore");
  more.style.display = d.next_cursor ? "" : "none";

  buildTable(el("flowList"), [
    {text:"Time"}, {text:"Source"}, {text:"Destination"}, {text:"Verified reporter"}, {text:"Service"},
    {text:"Type"}, {text:"Policy"}, {text:"Tx", num:true}, {text:"Rx", num:true}
  ], rows.map(function(f){
    var pill = document.createElement("span");
    pill.className = "pill " + f.traffic_type;
    // Underlay rows say how they were carried: that is the only thing that
    // distinguishes one physical connection from another on this list.
    pill.textContent = f.path ? f.traffic_type + " · " + pathText(f.path) : f.traffic_type;
    if (f.path === "derp" && f.derp_region) pill.title = "via DERP region " + f.derp_region;
    // An unevaluated connection shows an em dash, not a verdict: no policy was
    // collected, or this is underlay traffic no policy describes.
    var verdict = document.createElement("span");
    verdict.className = "verdict " + verdictKey(f.verdict, f.reversed);
    verdict.textContent = verdictText(f.verdict, f.reversed) || "—";
    if (f.verdict === "permitted") verdict.title = "rule #" + f.rule;
    // An absent endpoint is shown as an em dash, never as a made-up address:
    // exit records genuinely carry no destination.
    return {
      cells: [
        {text: fmtTime(f.time), cls:"mono"},
        {node: endpointCell(f.src_node, f.src_addr, f.src_user, f.src_tags, f.src_os), cls:"mono"},
        {node: endpointCell(f.dst_node, f.dst_addr, f.dst_user, f.dst_tags, f.dst_os), cls:"mono"},
        {node: reporterCell(f), cls:"mono"},
        {text: f.dst_service || "—", cls:"mono"},
        {node: pill},
        {node: verdict},
        {text: fmtBytes(f.counts.tx_bytes), cls:"num"},
        {text: fmtBytes(f.counts.rx_bytes), cls:"num"}
      ]
    };
  }), anyFilterSet() || state.selected || state.cell
    ? "nothing matches the current filter"
    : "no connections retained yet");
}

// anyFilterSet reports whether any of the seven server-side filter fields is
// non-empty, so the empty-table message can distinguish "genuinely nothing
// retained yet" from "your filter matched nothing".
function anyFilterSet(){
  var f = state.filters;
  return !!(f.device || f.addr || f.service || f.identity || f.type || f.verdict || f.path);
}

// ------------------------------------------------------------------- wiring

function toggleTheme(){
  var cur = document.documentElement.getAttribute("data-theme");
  if (!cur) cur = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
  var next = cur === "dark" ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", next);
  try { localStorage.setItem("ts2otel-theme", next); } catch(e){}
  if (state.data) render(state.data);
}

function init(){
  el("themeToggle").addEventListener("click", toggleTheme);
  el("refreshBtn").addEventListener("click", poll);
  el("liveBtn").addEventListener("click", function(){
    if (state.end) resetWindow();
  });
  el("nowBtn").addEventListener("click", resetWindow);

  Array.prototype.forEach.call(document.querySelectorAll("#winSeg button"), function(b){
    b.addEventListener("click", function(){
      Array.prototype.forEach.call(document.querySelectorAll("#winSeg button"), function(o){
        o.setAttribute("aria-pressed", o === b ? "true" : "false");
      });
      state.window = b.getAttribute("data-win");
      state.end = null;
      setLive(true);
      syncURL(true);
      poll();
    });
  });

  Array.prototype.forEach.call(document.querySelectorAll("#matrixSeg button"), function(b){
    b.addEventListener("click", function(){
      Array.prototype.forEach.call(document.querySelectorAll("#matrixSeg button"), function(o){
        o.setAttribute("aria-pressed", o === b ? "true" : "false");
      });
      state.matrixKind = b.getAttribute("data-kind");
      // A cell identifies a pair within ONE kind; carrying it across kinds would
      // filter on values that do not exist there.
      state.cell = null;
      el("matrixClear").style.display = "none";
      syncURL(true);
      if (state.data){ renderMatrix(state.data); renderFlows(state.data); }
    });
  });
  el("matrixClear").addEventListener("click", function(){
    state.cell = null;
    this.style.display = "none";
    syncURL(true);
    if (state.data){ renderMatrix(state.data); renderFlows(state.data); }
  });

  el("topSel").addEventListener("change", function(){
    state.top = parseInt(this.value, 10) || 20;
    state.positions = {}; // a different top-N is a different graph
    poll();
  });

  if (TAILNETS && TAILNETS.length > 1){
    el("tailnetWrap").style.display = "";
    TAILNETS.forEach(function(n){
      var o = document.createElement("option");
      o.value = n; o.textContent = n;
      if (n === state.tailnet) o.selected = true;
      el("tnSel").appendChild(o);
    });
    el("tnSel").addEventListener("change", function(){
      state.tailnet = this.value;
      state.positions = {};
      state.selected = null;
      syncURL(true);
      poll();
    });
  }

  // The seven filter fields are server-side (#296): every change refetches
  // rather than re-filtering the DOM, because the whole point is to reach
  // rows the current page does not hold. Text fields are debounced so a
  // fast typist doesn't fire a request per keystroke; the two closed-
  // enumeration selects (type/verdict/path) refetch immediately.
  //
  // push distinguishes a real navigation from continuous typing (#298): a
  // discrete pick (a select's change, or the clear-filters button) pushes a
  // history entry, but the debounced text-field path replaces the current
  // entry so the back button is not flooded with one entry per keystroke.
  var filterFieldIds = {
    device: "filterDevice", addr: "filterAddr", service: "filterService",
    identity: "filterIdentity", type: "filterType", verdict: "filterVerdict", path: "filterPath"
  };
  var filterDebounce = null;
  function onFilterChanged(push){
    Object.keys(filterFieldIds).forEach(function(k){ state.filters[k] = el(filterFieldIds[k]).value; });
    state.selected = null; // a server-side search supersedes a topology click
    syncURL(!!push);
    poll();
  }
  Object.keys(filterFieldIds).forEach(function(key){
    var input = el(filterFieldIds[key]);
    var debounced = input.tagName === "SELECT";
    input.addEventListener(debounced ? "change" : "input", function(){
      if (debounced){ onFilterChanged(true); return; }
      if (filterDebounce) clearTimeout(filterDebounce);
      filterDebounce = setTimeout(function(){ onFilterChanged(false); }, 300);
    });
  });
  el("flowClear").addEventListener("click", function(){
    Object.keys(filterFieldIds).forEach(function(key){ el(filterFieldIds[key]).value = ""; });
    onFilterChanged(true);
  });
  el("flowLoadMore").addEventListener("click", loadMore);

  // Re-lay-out on resize: the SVGs are sized in CSS pixels, so their viewBox has
  // to follow the element rather than the other way round.
  var resizeTimer = null;
  window.addEventListener("resize", function(){
    if (resizeTimer) clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function(){
      if (state.data){ renderTimeline(state.data); renderTopology(state.data); }
    }, 200);
  });

  // Restore view state from the URL (#298) — a fresh open, a pasted link, or
  // a bookmark — now that every control it might set (window buttons, the
  // matrix segment, the tailnet select, the filter inputs) exists in the
  // DOM. syncURL(false) then canonicalizes the address bar (a value that
  // failed safe to a default is reflected as that default, not left showing
  // whatever was actually typed) without adding a spurious history entry for
  // page load itself.
  applyStateFromLocation();
  syncURL(false);

  // Back/forward must actually navigate the view, not just change the address
  // bar: re-read the URL and re-fetch on every popstate.
  window.addEventListener("popstate", function(){
    applyStateFromLocation();
    poll();
  });

  poll();
}

if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
else init();
</script>
</body>
</html>
