<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preload" href="/_static/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
<title>{{.ServiceName}} — events</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='6' fill='%234493f8'/%3E%3C/svg%3E">
<style>
/* ─────────────────────────────────────────────────────────────────────────────
   m7kni Design System v2 - 2otel console family token block.
   SHARED VERBATIM across tailscale2otel, opnsense2otel, graph2otel,
   codexlb2otel. Do not edit in one repo only. Generated from
   packages/tokens (DTCG) - hex values are the resolved sRGB of the oklch
   sources noted per line.
   ───────────────────────────────────────────────────────────────────────── */
:root{
  /* Type */
  --t2o-sans:"Hanken Grotesk",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --t2o-mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --t2o-fs-2xs:10px;   /* uppercase micro labels */
  --t2o-fs-xs:11px;    /* mono sub-values, notes, badges */
  --t2o-fs-sm:12.5px;  /* table cells, controls, machine text */
  --t2o-fs-md:13.5px;  /* body copy */
  --t2o-fs-lg:15px;    /* page title, card values */
  --t2o-fs-xl:18px;    /* posture values */
  --t2o-fs-2xl:24px;   /* rare, one per page at most */
  --t2o-fw-regular:400;
  --t2o-fw-medium:500;
  --t2o-fw-semibold:600;
  --t2o-tracking-label:0.13em;

  /* Space and shape */
  --t2o-space-1:4px;  --t2o-space-2:8px;  --t2o-space-3:12px;
  --t2o-space-4:16px; --t2o-space-5:20px; --t2o-space-6:24px;
  --t2o-radius-control:3px;    /* buttons, inputs, chips, badges */
  --t2o-radius-container:0px;  /* panels, cards, tables - square */
  --t2o-radius-overlay:6px;    /* tooltips, popovers */
  --t2o-row:36px;              /* table row height */
  --t2o-dur-fast:120ms; --t2o-dur-base:160ms;

  /* Light theme - the default */
  --t2o-bg:#eef3f6;            /* oklch(0.962 0.007 227) */
  --t2o-surface:#f6fafb;       /* oklch(0.982 0.004 227) */
  --t2o-raised:#ffffff;        /* oklch(1 0 0) - table headers, inputs */
  --t2o-hover:#e7eef1;         /* oklch(0.945 0.009 227) */
  --t2o-selected:#dee8ec;      /* oklch(0.925 0.012 227) */
  --t2o-track:#c7cfd3;         /* oklch(0.85 0.01 227) - bar troughs */
  --t2o-fg:#192124;            /* oklch(0.24 0.012 227) */
  --t2o-fg-soft:#384146;       /* oklch(0.37 0.015 227) */
  --t2o-fg-muted:#59666b;      /* oklch(0.5 0.018 227) */
  --t2o-fg-faint:#869196;      /* oklch(0.65 0.015 227) - placeholder/disabled ONLY */
  --t2o-accent:#1d6a8a;        /* petrol */
  --t2o-accent-hover:#175874;
  --t2o-accent-soft:#e4eef4;   /* banner and selected-row wash */
  --t2o-on-accent:#ffffff;
  --t2o-line:#d9dfe2;          /* oklch(0.9 0.008 227) */
  --t2o-line-strong:#bec5c9;   /* oklch(0.82 0.01 227) */
  --t2o-ok:#2f7d4f;
  --t2o-warn:#8f6410;
  --t2o-fail:#a83a2e;

  /* Direction pair - see section 7 */
  --t2o-tx:var(--t2o-accent);
  --t2o-rx:var(--t2o-fg);
}

/* No stored preference: follow the OS. Explicit data-theme always wins. */
@media (prefers-color-scheme: dark){
  :root:not([data-theme]){
    --t2o-bg:#101618; --t2o-surface:#161d20; --t2o-raised:#1e2529;
    --t2o-hover:#1b2225; --t2o-selected:#222a2e; --t2o-track:#373f42;
    --t2o-fg:#e1e5e8; --t2o-fg-soft:#b7bfc3; --t2o-fg-muted:#95a1a6; --t2o-fg-faint:#697478;
    --t2o-accent:#66aecb; --t2o-accent-hover:#7cbcd6; --t2o-accent-soft:#1f2f38;
    --t2o-on-accent:#0e161b;
    --t2o-line:#2a3235; --t2o-line-strong:#40494e;
    --t2o-ok:#5fae7f; --t2o-warn:#c9a04a; --t2o-fail:#d97b64;
  }
}
:root[data-theme="light"]{
  --t2o-bg:#eef3f6; --t2o-surface:#f6fafb; --t2o-raised:#ffffff;
  --t2o-hover:#e7eef1; --t2o-selected:#dee8ec; --t2o-track:#c7cfd3;
  --t2o-fg:#192124; --t2o-fg-soft:#384146; --t2o-fg-muted:#59666b; --t2o-fg-faint:#869196;
  --t2o-accent:#1d6a8a; --t2o-accent-hover:#175874; --t2o-accent-soft:#e4eef4;
  --t2o-on-accent:#ffffff;
  --t2o-line:#d9dfe2; --t2o-line-strong:#bec5c9;
  --t2o-ok:#2f7d4f; --t2o-warn:#8f6410; --t2o-fail:#a83a2e;
}
:root[data-theme="dark"]{
  --t2o-bg:#101618; --t2o-surface:#161d20; --t2o-raised:#1e2529;
  --t2o-hover:#1b2225; --t2o-selected:#222a2e; --t2o-track:#373f42;
  --t2o-fg:#e1e5e8; --t2o-fg-soft:#b7bfc3; --t2o-fg-muted:#95a1a6; --t2o-fg-faint:#697478;
  --t2o-accent:#66aecb; --t2o-accent-hover:#7cbcd6; --t2o-accent-soft:#1f2f38;
  --t2o-on-accent:#0e161b;
  --t2o-line:#2a3235; --t2o-line-strong:#40494e;
  --t2o-ok:#5fae7f; --t2o-warn:#c9a04a; --t2o-fail:#d97b64;
}

/* ── Compatibility aliases ───────────────────────────────────────────────────
   The three templates already reference --bg/--panel/--line/... in hundreds of
   places, including inside JS that writes `fill:"var(--rx)"` into SVG. Keeping
   these aliases means the restyle lands as a palette swap plus targeted
   per-page edits, not a rename sweep. New CSS should use the --t2o-* names.
   ───────────────────────────────────────────────────────────────────────── */
:root{
  --bg:var(--t2o-bg);
  --panel:var(--t2o-surface);
  --panel2:var(--t2o-raised);
  --line:var(--t2o-line);
  --fg:var(--t2o-fg);
  --muted:var(--t2o-fg-muted);
  --accent:var(--t2o-accent);
  --ok:var(--t2o-ok);
  --warn:var(--t2o-warn);
  --err:var(--t2o-fail);
  --pending:var(--t2o-fg-muted);
  --grid:var(--t2o-line);
  --tx:var(--t2o-tx);
  --rx:var(--t2o-rx);
  --mono:var(--t2o-mono);
}
@font-face{
  font-family:"Hanken Grotesk";font-style:normal;font-weight:100 900;font-display:swap;
  src:url("/_static/fonts/hanken-grotesk-latin.woff2") format("woff2");
  unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face{
  font-family:"Hanken Grotesk";font-style:normal;font-weight:100 900;font-display:swap;
  src:url("/_static/fonts/hanken-grotesk-latin-ext.woff2") format("woff2");
  unicode-range:U+0100-024F,U+0259,U+1E00-1EFF,U+2020,U+20A0-20AB,U+20AD-20CF,U+2113,U+2C60-2C7F,U+A720-A7FF;
}
@font-face{
  font-family:"JetBrains Mono";font-style:normal;font-weight:100 800;font-display:swap;
  src:url("/_static/fonts/JetBrainsMono-Variable.woff2") format("woff2");
}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--fg);
    font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  a{color:var(--accent);text-decoration:none}
  code{font-family:var(--mono);font-size:12px;background:var(--panel2);padding:1px 5px;border-radius:4px}
  header{padding:16px 24px;border-bottom:1px solid var(--line);
    display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
  header h1{margin:0;font-size:19px;font-weight:600}
  header .ver{color:var(--muted);font-family:var(--mono);font-size:13px}
  header .spacer{flex:1}
  main{max-width:1320px;margin:0 auto;padding:18px 24px 60px}
  section{margin:0 0 24px}
  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px;margin-bottom:18px}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px 14px}
  .card .k{color:var(--muted);font-size:12px;margin-bottom:5px}
  .card .v{font-size:19px;font-weight:600;font-variant-numeric:tabular-nums}
  .card.warn2{border-color:var(--warn)}
  .controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:18px;
    padding:11px 14px;background:var(--panel);border:1px solid var(--line);border-radius:10px}
  .controls label{color:var(--muted);font-size:12px}
  button.ctl,select.ctl,input.ctl{background:var(--panel2);color:var(--fg);border:1px solid var(--line);
    border-radius:7px;padding:4px 10px;font-size:12px;font-family:inherit;cursor:pointer}
  input.ctl{cursor:text}
  button.ctl:hover,select.ctl:hover{border-color:var(--accent)}
  button.ctl[aria-pressed="true"]{border-color:var(--accent);color:var(--accent)}
  .spacer{flex:1}
  .banner{display:none;padding:8px 24px;font-size:13px;border-bottom:1px solid var(--line)}
  .banner.show{display:block}
  #errBanner{background:rgba(248,81,73,.16);color:var(--err)}
  #truncBanner{background:rgba(210,153,34,.16);color:var(--warn)}
  /* Focus-visible: keyboard focus always gets a visible ring; a mouse click
     alone does not (browsers already suppress :focus-visible for pointer
     interaction on non-form elements). The default browser outline is hard
     to see against this page's dark palette, so filter inputs, selects and
     buttons need an explicit one. */
  :focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  /* This page has no perceptible animation (no charts, no force-directed
     layout, no auto-scrolling) — nothing here needs to be skipped for
     reduced motion. This rule is defensive, matching statushtml's own
     documented-as-defensive treatment (#327), not a behavior fix. */
  @media (prefers-reduced-motion: reduce){
    *{scroll-behavior:auto!important}
  }
  table{width:100%;border-collapse:collapse;background:var(--panel);
    border:1px solid var(--line);border-radius:10px;overflow:hidden}
  th,td{text-align:left;padding:7px 11px;border-bottom:1px solid var(--line);
    font-variant-numeric:tabular-nums;vertical-align:top}
  th{color:var(--muted);font-size:12px;font-weight:600;background:var(--panel2)}
  tr:last-child td{border-bottom:0}
  td.mono{font-family:var(--mono);font-size:12px;overflow-wrap:anywhere}
  td.details{max-width:420px;overflow-wrap:anywhere;font-family:var(--mono);font-size:11px;color:var(--muted)}
  .sev{display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:600}
  .sev-info{background:rgba(63,185,80,.16);color:var(--ok)}
  .sev-warn{background:rgba(210,153,34,.16);color:var(--warn)}
  .src{display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-family:var(--mono);
    background:var(--panel2);color:var(--muted)}
  .empty{color:var(--muted);font-size:13px;padding:14px;text-align:center}
/* Console v2 application layer. The family token block above remains unchanged. */
body{background:var(--t2o-bg);color:var(--t2o-fg-soft);font:var(--t2o-fs-md)/1.5 var(--t2o-sans)}
a{color:var(--t2o-accent)}
header{padding:12px 20px;background:var(--t2o-surface);border-bottom:1px solid var(--t2o-line)}
header h1{font:var(--t2o-fw-semibold) var(--t2o-fs-lg)/1.2 var(--t2o-sans)}
header .ver{font:var(--t2o-fs-xs)/1.3 var(--t2o-mono);color:var(--t2o-fg-muted)}
main{max-width:1320px;padding:18px 24px 60px}
section>h2,.sub-h,.card .k{font:var(--t2o-fw-semibold) var(--t2o-fs-2xs)/1.2 var(--t2o-sans);letter-spacing:var(--t2o-tracking-label);text-transform:uppercase;color:var(--t2o-fg-muted)}
.cards{grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.card,.panel,.controls,.rollup,details{border-radius:var(--t2o-radius-container);background:var(--t2o-surface);border-color:var(--t2o-line)}
.card{padding:10px 12px}.card .v{font:var(--t2o-fw-medium) var(--t2o-fs-lg)/1.2 var(--t2o-mono);font-variant-numeric:tabular-nums}.card .sub{font:var(--t2o-fs-xs)/1.4 var(--t2o-mono);color:var(--t2o-fg-muted)}
table{border-radius:var(--t2o-radius-container);border-color:var(--t2o-line);background:var(--t2o-surface)}
th{position:sticky;top:0;z-index:1;background:var(--t2o-raised);border-bottom-color:var(--t2o-line-strong);font:var(--t2o-fw-semibold) var(--t2o-fs-2xs)/1.2 var(--t2o-sans);letter-spacing:var(--t2o-tracking-label);text-transform:uppercase;color:var(--t2o-fg-muted)}
td{height:var(--t2o-row);padding:8px 12px;border-bottom-color:var(--t2o-line);font:var(--t2o-fs-sm)/1.4 var(--t2o-mono);font-variant-numeric:tabular-nums}
tbody tr:hover{background:var(--t2o-raised)}tr.bad>td{background:transparent}tr.bad{box-shadow:inset 2px 0 0 var(--t2o-fail)}
td.num{text-align:right}.mono,code{font-family:var(--t2o-mono)}
button.ctl,select.ctl,input.ctl,.filter,.seg{border-radius:var(--t2o-radius-control);background:var(--t2o-raised);border-color:var(--t2o-line-strong);font:var(--t2o-fs-sm)/1.3 var(--t2o-sans)}
button.ctl:hover,select.ctl:hover,.filter:hover{background:var(--t2o-hover);border-color:var(--t2o-accent)}
.badge{border:1px solid currentColor;border-radius:var(--t2o-radius-control);background:transparent!important;font:var(--t2o-fw-semibold) var(--t2o-fs-xs)/1.4 var(--t2o-sans);letter-spacing:.06em;text-transform:uppercase}
.badge.ok{color:var(--t2o-ok)}.badge.err,.badge.critical,.badge.degraded{color:var(--t2o-fail)}.badge.warn,.badge.warning{color:var(--t2o-warn)}.badge.pending,.badge.stale,.badge.none{color:var(--t2o-fg-muted)}
:focus-visible{outline:2px solid var(--t2o-accent);outline-offset:2px}
@media (max-width:760px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
:root[data-theme="light"]{color-scheme:light}:root[data-theme="dark"]{color-scheme:dark}@media (prefers-color-scheme: dark){:root:not([data-theme]){color-scheme:dark}}
.cards{grid-template-columns:repeat(5,minmax(0,1fr))}.controls{border-radius:var(--t2o-radius-container)}#btnApply{border-color:var(--t2o-accent);color:var(--t2o-accent)}.sev,.src{border:1px solid currentColor;border-radius:var(--t2o-radius-control);background:transparent!important;font-family:var(--t2o-mono)}.sev-info{color:var(--t2o-fg-muted)}.sev-warn{color:var(--t2o-warn)}#errBanner,#truncBanner{display:flex;align-items:center;gap:8px;background:var(--t2o-accent-soft);color:var(--t2o-fg-soft)}#errBanner{border-left:2px solid var(--t2o-fail)}#truncBanner{border-left:2px solid var(--t2o-warn)}#errBanner::before,#truncBanner::before{content:"!";display:inline-grid;place-items:center;width:14px;height:14px;font:var(--t2o-fw-semibold) var(--t2o-fs-xs)/1 var(--t2o-sans)}#errBanner::before{border:1px solid var(--t2o-fail);border-radius:50%;color:var(--t2o-fail)}#truncBanner::before{border:1px solid var(--t2o-warn);color:var(--t2o-warn)}@media (max-width:760px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
<script>
  // Apply the persisted theme before first paint. This shares the console family's key.
  (function(){try{var t=localStorage.getItem('ts2otel-theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();
</script>
</head>
<body>
<header>
  <h1>{{.ServiceName}} events</h1>
  <span class="ver">{{.Version}}</span>
  <span class="spacer"></span>
  <a href="/">status &rarr;</a>
  <button class="ctl" id="themeToggle" title="Toggle light/dark theme" aria-label="Toggle theme">&#9686;</button>
</header>
<div id="errBanner" class="banner" role="alert"></div>
<div id="truncBanner" class="banner" role="status"></div>
<main>
  <section>
    <div class="cards" id="statsCards">
      <div class="card"><div class="k">Retained</div><div class="v" id="statRetained">—</div></div>
      <div class="card"><div class="k">Capacity</div><div class="v" id="statCapacity">—</div></div>
      <div class="card"><div class="k">Recorded (total)</div><div class="v" id="statRecorded">—</div></div>
      <div class="card" id="statEvictedCard"><div class="k">Evicted (overflow)</div><div class="v" id="statEvicted">—</div></div>
      <div class="card"><div class="k">Matched</div><div class="v" id="statMatched">—</div></div>
    </div>
  </section>
  <section>
    <div class="controls">
      <label for="fSource">source</label>
      <select class="ctl" id="fSource">
        <option value="">any</option>
        <option value="audit">audit</option>
        <option value="webhook">webhook</option>
      </select>
      <label for="fSeverity">severity</label>
      <select class="ctl" id="fSeverity">
        <option value="">any</option>
        <option value="info">info</option>
        <option value="warn">warn</option>
      </select>
      <label for="fActor">actor</label>
      <input class="ctl" id="fActor" type="text" placeholder="substring">
      <label for="fAction">action</label>
      <input class="ctl" id="fAction" type="text" placeholder="substring">
      <label for="fTarget">target</label>
      <input class="ctl" id="fTarget" type="text" placeholder="substring">
      <label for="fType">type</label>
      <input class="ctl" id="fType" type="text" placeholder="exact">
      <label><input type="checkbox" id="fErrors"> errors only</label>
      <span class="spacer"></span>
      <button class="ctl" id="btnApply">apply</button>
      <button class="ctl" id="btnClear">clear</button>
    </div>
  </section>
  <section>
    <table>
      <thead>
        <tr>
          <th>time</th><th>source</th><th>severity</th><th>action / type</th>
          <th>actor</th><th>target</th><th>error</th><th>details</th>
        </tr>
      </thead>
      <tbody id="eventsBody"></tbody>
    </table>
    <div class="empty" id="emptyState" style="display:none">no events match the current filters</div>
  </section>
</main>
<script>
(function(){
  "use strict";
  var refreshMs = {{.RefreshMs}};
  var qs = function(id){ return document.getElementById(id); };
  var esc = function(s){
    var d = document.createElement("div");
    d.textContent = s == null ? "" : String(s);
    return d.innerHTML;
  };
  var fmtTime = function(t){
    if (!t) return "";
    var d = new Date(t);
    if (isNaN(d.getTime())) return t;
    return d.toISOString().replace("T"," ").replace("Z","");
  };

  function currentFilters(){
    return {
      source: qs("fSource").value,
      severity: qs("fSeverity").value,
      actor: qs("fActor").value,
      action: qs("fAction").value,
      target: qs("fTarget").value,
      type: qs("fType").value,
      errors: qs("fErrors").checked
    };
  }

  function buildQuery(){
    var f = currentFilters();
    var p = new URLSearchParams();
    if (f.source) p.set("source", f.source);
    if (f.severity) p.set("severity", f.severity);
    if (f.actor) p.set("actor", f.actor);
    if (f.action) p.set("action", f.action);
    if (f.target) p.set("target", f.target);
    if (f.type) p.set("type", f.type);
    if (f.errors) p.set("errors", "1");
    return p.toString();
  }

  function renderStats(stats, matched){
    qs("statRetained").textContent = stats.retained;
    qs("statCapacity").textContent = stats.capacity;
    qs("statRecorded").textContent = stats.recorded;
    qs("statEvicted").textContent = stats.evicted;
    qs("statMatched").textContent = matched;
    var card = qs("statEvictedCard");
    if (stats.evicted > 0) { card.classList.add("warn2"); } else { card.classList.remove("warn2"); }
  }

  function severityBadge(sev){
    var cls = sev === "warn" ? "sev-warn" : "sev-info";
    return '<span class="sev ' + cls + '">' + esc(sev || "info") + '</span>';
  }

  function sourceBadge(src){
    return '<span class="src">' + esc(src) + '</span>';
  }

  function renderRows(rows){
    var body = qs("eventsBody");
    var frag = document.createDocumentFragment();
    rows.forEach(function(e){
      var tr = document.createElement("tr");
      var actor = e.actor_name || e.actor_id || "";
      var target = e.target_name || e.target_id || "";
      var actionType = e.action || "";
      if (e.type && e.type !== e.action) { actionType += " / " + e.type; }
      tr.innerHTML =
        '<td class="mono">' + esc(fmtTime(e.time)) + '</td>' +
        '<td>' + sourceBadge(e.source) + '</td>' +
        '<td>' + severityBadge(e.severity) + '</td>' +
        '<td class="mono">' + esc(actionType) + '</td>' +
        '<td class="mono">' + esc(actor) + '</td>' +
        '<td class="mono">' + esc(target) + '</td>' +
        '<td class="mono">' + esc(e.error || "") + '</td>' +
        '<td class="details">' + esc(e.summary || "") + (e.details ? ("<br>" + esc(e.details)) : "") +
          (e.truncated ? ' <em>(truncated)</em>' : '') + '</td>';
      frag.appendChild(tr);
    });
    body.innerHTML = "";
    body.appendChild(frag);
    qs("emptyState").style.display = rows.length === 0 ? "block" : "none";
  }

// === shared poller helper (#328) — keep byte-for-byte identical across
// statushtml, flowhtml and eventshtml; see TestPollerHelperIdenticalAcrossPages
// in each package. createPoller wraps a periodic fetch with:
//   - single-flight: a tick that lands while the previous one is still
//     outstanding is folded into the next scheduled tick rather than firing
//     a second concurrent request.
//   - a per-call timeout via AbortController, so a hung request cannot pin
//     the poller in the in-flight state forever.
//   - exponential backoff on failure (capped at maxMs), reset to baseMs by
//     the next success, by start(), or by kick().
//   - automatic pause while the tab is hidden (visibilitychange stops the
//     timer outright), and an immediate poll with backoff reset when the
//     tab becomes visible again — but only while periodic polling is
//     actually enabled (paused===false); a caller-initiated stop() (a
//     paused/pinned view) is never silently resumed by a visibility flip.
//   - stale-response rejection: every tick is tagged with a monotonically
//     increasing sequence number, and a response only reaches onResult (or
//     onError) if no later tick has already landed — a slow response that
//     resolves after a newer one arrived is dropped, never applied.
// start() arms the periodic timer but does not fetch immediately (a caller
// that also wants an immediate fetch calls kick() itself, since several
// call sites — a filter change, a pinned-window click — want a fetch
// without necessarily re-arming periodic polling). kick() always fires one
// fetch right now regardless of paused, and never conflicts with an
// in-flight request thanks to the single-flight guard above.
function createPoller(opts){
  var fetchFn = opts.fetchFn;     // function(signal) -> Promise(data)
  var onResult = opts.onResult;   // function(data)
  var onError = opts.onError;     // function(err), optional
  var baseMs = opts.baseMs;       // steady-state interval; <=0 disables periodic scheduling
  var maxMs = opts.maxMs || (baseMs > 0 ? baseMs * 8 : 0);
  var timeoutMs = opts.timeoutMs || 10000;

  var timer = null;
  var inFlight = false;
  var seq = 0;
  var maxSeenSeq = 0;
  var backoffMs = baseMs;
  var paused = true;

  function clearTimer(){ if (timer) { clearTimeout(timer); timer = null; } }

  function scheduleNext(delay){
    clearTimer();
    if (paused || baseMs <= 0) return;
    if (typeof document !== "undefined" && document.hidden) return;
    timer = setTimeout(tick, delay);
  }

  function tick(){
    if (inFlight) { scheduleNext(baseMs); return; }
    inFlight = true;
    var mySeq = ++seq;
    var controller = (typeof AbortController !== "undefined") ? new AbortController() : null;
    var timedOut = false;
    var timeoutId = controller ? setTimeout(function(){ timedOut = true; controller.abort(); }, timeoutMs) : null;
    fetchFn(controller ? controller.signal : undefined).then(function(data){
      if (timeoutId) clearTimeout(timeoutId);
      inFlight = false;
      if (mySeq <= maxSeenSeq) return;
      maxSeenSeq = mySeq;
      backoffMs = baseMs;
      onResult(data);
      scheduleNext(backoffMs);
    }, function(err){
      if (timeoutId) clearTimeout(timeoutId);
      inFlight = false;
      if (mySeq <= maxSeenSeq) return;
      maxSeenSeq = mySeq;
      backoffMs = baseMs > 0 ? Math.min(maxMs, Math.max(baseMs, backoffMs * 2)) : baseMs;
      if (onError) onError(timedOut ? new Error("timed out") : err);
      scheduleNext(backoffMs);
    });
  }

  function start(){
    paused = false;
    backoffMs = baseMs;
    scheduleNext(baseMs);
  }
  function stop(){
    paused = true;
    clearTimer();
  }
  function kick(){
    backoffMs = baseMs;
    clearTimer();
    tick();
  }

  if (typeof document !== "undefined" && typeof document.addEventListener === "function"){
    document.addEventListener("visibilitychange", function(){
      if (document.hidden){
        clearTimer();
      } else if (!paused){
        backoffMs = baseMs;
        clearTimer();
        tick();
      }
    });
  }

  return {start: start, stop: stop, kick: kick};
}
// === end shared poller helper ===

  function fetchEvents(signal){
    var url = "/api/events.json" + (buildQuery() ? "?" + buildQuery() : "");
    return fetch(url, {credentials: "same-origin", signal: signal}).then(function(resp){
      if (!resp.ok) { throw new Error("http " + resp.status); }
      return resp.json();
    });
  }

  function applyEvents(data){
    qs("errBanner").classList.remove("show");
    renderStats(data.stats, data.matched);
    renderRows(data.rows || []);
    var trunc = qs("truncBanner");
    if (data.truncated) {
      trunc.textContent = "the event ring is at capacity: older matching events may already have been evicted.";
      trunc.classList.add("show");
    } else {
      trunc.classList.remove("show");
    }
  }

  function eventsPollError(err){
    var banner = qs("errBanner");
    banner.textContent = "failed to load events: " + err.message;
    banner.classList.add("show");
  }

  // eventsPoller drives /api/events.json on a timer (#328): single-flight,
  // AbortController-backed timeout, capped exponential backoff, paused
  // while the tab is hidden, and immune to a stale response landing after a
  // newer one (a slow response for a filter that has since changed again is
  // dropped rather than overwriting the current view). refreshMs<=0 (the
  // page's existing "disable auto-refresh" knob) is preserved unchanged:
  // createPoller's baseMs<=0 path never arms a periodic timer, so poll()
  // still runs exactly once at load either way.
  var eventsPoller = createPoller({
    fetchFn: fetchEvents,
    onResult: applyEvents,
    onError: eventsPollError,
    baseMs: refreshMs
  });

  // poll() is the single entry point every call site already used before
  // #328 (apply/clear filters, the initial load) — kept as a thin facade
  // over eventsPoller.kick() so none of those call sites needed to change.
  function poll(){
    eventsPoller.kick();
  }

  qs("btnApply").addEventListener("click", poll);
  qs("btnClear").addEventListener("click", function(){
    qs("fSource").value = "";
    qs("fSeverity").value = "";
    qs("fActor").value = "";
    qs("fAction").value = "";
    qs("fTarget").value = "";
    qs("fType").value = "";
    qs("fErrors").checked = false;
    poll();
  });

  qs("themeToggle").addEventListener("click", function(){
    var current = document.documentElement.getAttribute("data-theme");
    if (!current) current = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    var next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    try { localStorage.setItem("ts2otel-theme", next); } catch(e) {}
  });

  eventsPoller.kick();
  if (refreshMs > 0) { eventsPoller.start(); }
})();
</script>
</body>
</html>
